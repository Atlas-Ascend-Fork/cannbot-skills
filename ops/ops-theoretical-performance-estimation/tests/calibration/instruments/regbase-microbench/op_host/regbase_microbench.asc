#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "../op_kernel/regbase_microbench_tiling.h"
#include "../op_kernel/regbase_microbench_kernel.asc"

namespace {

struct CaseInfo {
    const char* name;
    uint32_t caseId;
};

constexpr CaseInfo CASES[] = {
    {"add_fp32_independent", BENCH_ADD_FP32},
    {"mul_fp32_independent", BENCH_MUL_FP32},
    {"cast_f32_to_f16", BENCH_CAST_F32_TO_F16},
    {"muladddst_fp32", BENCH_MULADDDST_FP32},
    {"sqrt_fp32", BENCH_SQRT_FP32},
    {"reducesum_fp32", BENCH_REDUCESUM_FP32},
    {"sub_fp32_independent", BENCH_SUB_FP32},
    {"max_fp32_independent", BENCH_MAX_FP32},
    {"min_fp32_independent", BENCH_MIN_FP32},
    {"abs_fp32_independent", BENCH_ABS_FP32},
    {"relu_fp32_independent", BENCH_RELU_FP32},
    {"neg_fp32_independent", BENCH_NEG_FP32},
    {"log_fp32", BENCH_LOG_FP32},
    {"log2_fp32", BENCH_LOG2_FP32},
    {"log10_fp32", BENCH_LOG10_FP32},
    {"leakyrelu_fp32", BENCH_LEAKYRELU_FP32},
    {"prelu_fp32", BENCH_PRELU_FP32},
    {"abssub_fp32", BENCH_ABSSUB_FP32},
    {"expsub_fp32", BENCH_EXPSUB_FP32},
    {"mulscast_f32_to_f16", BENCH_MULSCAST_F32_TO_F16},
    {"addc_u32", BENCH_ADDC_U32},
    {"subc_u32", BENCH_SUBC_U32},
    {"interleave_u32", BENCH_INTERLEAVE_U32},
    {"deinterleave_u32", BENCH_DEINTERLEAVE_U32},
    {"pack_u32_to_u16", BENCH_PACK_U32_TO_U16},
    {"unpack_u16_to_u32", BENCH_UNPACK_U16_TO_U32},
    {"exp_fp32", BENCH_EXP_FP32},
    {"exp_then_sub_fp32", BENCH_EXP_THEN_SUB_FP32},
    {"add_u32_independent", BENCH_ADD_U32},
    {"add_s32_independent", BENCH_ADD_S32},
    {"exp_fp16", BENCH_EXP_FP16},
    {"exp_add2_fp32", BENCH_EXP_ADD2_FP32},
    {"exp_add4_fp32", BENCH_EXP_ADD4_FP32},
    {"exp_add8_fp32", BENCH_EXP_ADD8_FP32},
    {"exp_mul_add_fp32", BENCH_EXP_MUL_ADD_FP32},
    {"sqrt_add4_fp32", BENCH_SQRT_ADD4_FP32},
    {"exp_add4_indep_fp32", BENCH_EXP_ADD4_INDEP_FP32},
    {"exp_add8_indep_fp32", BENCH_EXP_ADD8_INDEP_FP32},
    {"div_fp32", BENCH_DIV_FP32},
    {"reducemax_fp32", BENCH_REDUCEMAX_FP32},
    {"cast_rt_f16", BENCH_CAST_RT_F16},
};

void CheckAcl(aclError ret, const char* what)
{
    if (ret != ACL_SUCCESS) {
        std::fprintf(stderr, "%s failed, ret=%d\n", what, ret);
        std::exit(static_cast<int>(ret));
    }
}

uint32_t ParseU32(const char* text, uint32_t fallback)
{
    if (text == nullptr || text[0] == '\0') {
        return fallback;
    }
    return static_cast<uint32_t>(std::strtoul(text, nullptr, 10));
}

uint32_t CaseIdFromName(const char* name)
{
    for (const auto& item : CASES) {
        if (std::strcmp(name, item.name) == 0) {
            return item.caseId;
        }
    }
    return 0;
}

void PrintUsage(const char* exe)
{
    std::fprintf(stderr, "Usage: %s <case_name> [iterations] [unroll] [block_dim]\n", exe);
    std::fprintf(stderr, "Cases:\n");
    for (const auto& item : CASES) {
        std::fprintf(stderr, "  %s\n", item.name);
    }
}

} // namespace

int32_t main(int32_t argc, char* argv[])
{
    if (argc < 2) {
        PrintUsage(argv[0]);
        return 2;
    }

    const char* caseName = argv[1];
    const uint32_t caseId = CaseIdFromName(caseName);
    if (caseId == 0) {
        PrintUsage(argv[0]);
        return 2;
    }

    const uint32_t iterations = argc > 2 ? ParseU32(argv[2], 20000) : 20000;
    const uint32_t unroll = argc > 3 ? ParseU32(argv[3], 16) : 16;
    const uint32_t blockDim = argc > 4 ? ParseU32(argv[4], 1) : 1;
    if (iterations == 0 || unroll == 0 || blockDim == 0) {
        std::fprintf(stderr, "iterations, unroll, and block_dim must be positive\n");
        return 2;
    }

    CheckAcl(aclInit(nullptr), "aclInit");
    CheckAcl(aclrtSetDevice(0), "aclrtSetDevice");

    std::vector<float> x(REGBASE_BENCH_F32_BUFFER_ELEMS, 4.0f);
    std::vector<float> y(REGBASE_BENCH_F32_BUFFER_ELEMS, 2.0f);
    std::vector<uint64_t> out(blockDim * REGBASE_BENCH_WORDS, 0);
    RegbaseBenchTilingData tiling{caseId, iterations, unroll, 0};

    uint8_t* xDevice = nullptr;
    uint8_t* yDevice = nullptr;
    uint8_t* outDevice = nullptr;
    uint8_t* tilingDevice = nullptr;
    aclrtStream stream = nullptr;

    CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&xDevice), x.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc x");
    CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&yDevice), y.size() * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc y");
    CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&outDevice), out.size() * sizeof(uint64_t),
        ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc out");
    CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&tilingDevice), sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc tiling");

    CheckAcl(aclrtMemcpy(xDevice, x.size() * sizeof(float), x.data(), x.size() * sizeof(float),
        ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy x");
    CheckAcl(aclrtMemcpy(yDevice, y.size() * sizeof(float), y.data(), y.size() * sizeof(float),
        ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy y");
    CheckAcl(aclrtMemcpy(outDevice, out.size() * sizeof(uint64_t), out.data(), out.size() * sizeof(uint64_t),
        ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy out");
    CheckAcl(aclrtMemcpy(tilingDevice, sizeof(tiling), &tiling, sizeof(tiling),
        ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy tiling");

    CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
    regbase_microbench_kernel<<<blockDim, nullptr, stream>>>(xDevice, yDevice, outDevice, tilingDevice);
    CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");

    CheckAcl(aclrtMemcpy(out.data(), out.size() * sizeof(uint64_t), outDevice, out.size() * sizeof(uint64_t),
        ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy output");

    for (uint32_t block = 0; block < blockDim; ++block) {
        const uint32_t offset = block * REGBASE_BENCH_WORDS;
        std::printf(
            "{\"case_name\":\"%s\",\"case_id\":%llu,\"block_idx\":%llu,\"magic\":%llu,"
            "\"version\":%llu,\"status\":%llu,\"iterations\":%llu,\"unroll\":%llu,"
            "\"logical_ops_per_unroll\":%llu,\"elements_per_inst\":%llu,"
            "\"empty_cycles\":%llu,\"measured_cycles\":%llu,\"body_cycles\":%llu,\"sink\":%llu}\n",
            caseName,
            static_cast<unsigned long long>(out[offset + REC_CASE_ID]),
            static_cast<unsigned long long>(out[offset + REC_BLOCK_IDX]),
            static_cast<unsigned long long>(out[offset + REC_MAGIC]),
            static_cast<unsigned long long>(out[offset + REC_VERSION]),
            static_cast<unsigned long long>(out[offset + REC_STATUS]),
            static_cast<unsigned long long>(out[offset + REC_ITERATIONS]),
            static_cast<unsigned long long>(out[offset + REC_UNROLL]),
            static_cast<unsigned long long>(out[offset + REC_LOGICAL_OPS_PER_UNROLL]),
            static_cast<unsigned long long>(out[offset + REC_ELEMENTS_PER_INST]),
            static_cast<unsigned long long>(out[offset + REC_EMPTY_CYCLES]),
            static_cast<unsigned long long>(out[offset + REC_MEASURED_CYCLES]),
            static_cast<unsigned long long>(out[offset + REC_BODY_CYCLES]),
            static_cast<unsigned long long>(out[offset + REC_SINK]));
    }

    CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream");
    CheckAcl(aclrtFree(tilingDevice), "aclrtFree tiling");
    CheckAcl(aclrtFree(outDevice), "aclrtFree out");
    CheckAcl(aclrtFree(yDevice), "aclrtFree y");
    CheckAcl(aclrtFree(xDevice), "aclrtFree x");
    CheckAcl(aclrtResetDevice(0), "aclrtResetDevice");
    CheckAcl(aclFinalize(), "aclFinalize");

    return 0;
}
