__simd_vf__ inline void AddCU32Vf(__ubuf__ uint32_t* x, __ubuf__ uint32_t* y, __ubuf__ uint32_t* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<uint32_t> xReg;
    AscendC::Reg::RegTensor<uint32_t> yReg;
    AscendC::Reg::RegTensor<uint32_t> zReg0;
    AscendC::Reg::RegTensor<uint32_t> zReg1;
    AscendC::Reg::RegTensor<uint32_t> zReg2;
    AscendC::Reg::RegTensor<uint32_t> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<uint32_t, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::MaskReg maskZero = AscendC::Reg::CreateMask<uint32_t, AscendC::Reg::MaskPattern::ALLF>();
    AscendC::Reg::MaskReg carry = AscendC::Reg::CreateMask<uint8_t>();
    for (uint32_t i = 0; i < iterations; ++i) {
        AscendC::Reg::LoadAlign(xReg, x + BENCH_LANE0);
        AscendC::Reg::LoadAlign(yReg, y + BENCH_LANE0);
        AscendC::Reg::LoadAlign(zReg0, z + BENCH_LANE0);
        AscendC::Reg::LoadAlign(zReg1, z + BENCH_LANE1);
        AscendC::Reg::LoadAlign(zReg2, z + BENCH_LANE2);
        AscendC::Reg::LoadAlign(zReg3, z + BENCH_LANE3);
        AscendC::Reg::AddC(carry, zReg0, zReg0, yReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg1, zReg1, yReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg2, zReg2, yReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg3, zReg3, yReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg0, zReg0, xReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg1, zReg1, xReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg2, zReg2, xReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg3, zReg3, xReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg0, zReg0, yReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg1, zReg1, yReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg2, zReg2, yReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg3, zReg3, yReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg0, zReg0, xReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg1, zReg1, xReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg2, zReg2, xReg, maskZero, mask);
        AscendC::Reg::AddC(carry, zReg3, zReg3, xReg, maskZero, mask);
        AscendC::Reg::StoreAlign<uint32_t, AscendC::Reg::MaskDist::DIST_NORM>(z + 32, carry);
        AscendC::Reg::StoreAlign(z + BENCH_LANE0, zReg0, mask);
        AscendC::Reg::StoreAlign(z + BENCH_LANE1, zReg1, mask);
        AscendC::Reg::StoreAlign(z + BENCH_LANE2, zReg2, mask);
        AscendC::Reg::StoreAlign(z + BENCH_LANE3, zReg3, mask);
    }
}

