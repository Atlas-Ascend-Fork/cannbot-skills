__simd_vf__ inline void PackU32ToU16Vf(__ubuf__ uint32_t* x, __ubuf__ uint16_t* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<uint32_t> zReg0;
    AscendC::Reg::RegTensor<uint32_t> zReg1;
    AscendC::Reg::RegTensor<uint32_t> zReg2;
    AscendC::Reg::RegTensor<uint32_t> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<uint16_t, AscendC::Reg::MaskPattern::ALL>();
    __ubuf__ uint32_t* zu32 = reinterpret_cast<__ubuf__ uint32_t*>(z); // in-place alias for cross-iter dependency
    for (uint32_t i = 0; i < iterations; ++i) {
        AscendC::Reg::LoadAlign(zReg0, zu32 + BENCH_LANE0);
        AscendC::Reg::LoadAlign(zReg1, zu32 + BENCH_LANE1);
        AscendC::Reg::LoadAlign(zReg2, zu32 + BENCH_LANE2);
        AscendC::Reg::LoadAlign(zReg3, zu32 + BENCH_LANE3);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::HIGHEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg0, zReg0);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::HIGHEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg1, zReg1);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::HIGHEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg2, zReg2);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::HIGHEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg3, zReg3);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::HIGHEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg0, zReg0);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::HIGHEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg1, zReg1);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::HIGHEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg2, zReg2);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::HIGHEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg3, zReg3);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::LOWEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg0, zReg0);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::LOWEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg1, zReg1);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::LOWEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg2, zReg2);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::LOWEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg3, zReg3);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::LOWEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg0, zReg0);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::LOWEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg1, zReg1);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::LOWEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg2, zReg2);
        AscendC::Reg::Pack<uint16_t, uint32_t, AscendC::Reg::HighLowPart::LOWEST>((AscendC::Reg::RegTensor<uint16_t>&)zReg3, zReg3);
        AscendC::Reg::StoreAlign(z + BENCH_U16_LANE0, (AscendC::Reg::RegTensor<uint16_t>&)zReg0, mask);
        AscendC::Reg::StoreAlign(z + BENCH_U16_LANE1, (AscendC::Reg::RegTensor<uint16_t>&)zReg1, mask);
        AscendC::Reg::StoreAlign(z + BENCH_U16_LANE2, (AscendC::Reg::RegTensor<uint16_t>&)zReg2, mask);
        AscendC::Reg::StoreAlign(z + BENCH_U16_LANE3, (AscendC::Reg::RegTensor<uint16_t>&)zReg3, mask);
    }
}

__simd_vf__ inline void UnPackU16ToU32Vf(__ubuf__ uint16_t* x, __ubuf__ uint32_t* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<uint32_t> zReg0;
    AscendC::Reg::RegTensor<uint32_t> zReg1;
    AscendC::Reg::RegTensor<uint32_t> zReg2;
    AscendC::Reg::RegTensor<uint32_t> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<uint32_t, AscendC::Reg::MaskPattern::ALL>();
    __ubuf__ uint16_t* zu16 = reinterpret_cast<__ubuf__ uint16_t*>(z); // in-place alias for cross-iter dependency
    for (uint32_t i = 0; i < iterations; ++i) {
        AscendC::Reg::LoadAlign((AscendC::Reg::RegTensor<uint16_t>&)zReg0, zu16 + BENCH_U16_LANE0);
        AscendC::Reg::LoadAlign((AscendC::Reg::RegTensor<uint16_t>&)zReg1, zu16 + BENCH_U16_LANE1);
        AscendC::Reg::LoadAlign((AscendC::Reg::RegTensor<uint16_t>&)zReg2, zu16 + BENCH_U16_LANE2);
        AscendC::Reg::LoadAlign((AscendC::Reg::RegTensor<uint16_t>&)zReg3, zu16 + BENCH_U16_LANE3);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::HIGHEST>(zReg0, (AscendC::Reg::RegTensor<uint16_t>&)zReg0);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::HIGHEST>(zReg1, (AscendC::Reg::RegTensor<uint16_t>&)zReg1);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::HIGHEST>(zReg2, (AscendC::Reg::RegTensor<uint16_t>&)zReg2);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::HIGHEST>(zReg3, (AscendC::Reg::RegTensor<uint16_t>&)zReg3);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::HIGHEST>(zReg0, (AscendC::Reg::RegTensor<uint16_t>&)zReg0);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::HIGHEST>(zReg1, (AscendC::Reg::RegTensor<uint16_t>&)zReg1);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::HIGHEST>(zReg2, (AscendC::Reg::RegTensor<uint16_t>&)zReg2);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::HIGHEST>(zReg3, (AscendC::Reg::RegTensor<uint16_t>&)zReg3);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::LOWEST>(zReg0, (AscendC::Reg::RegTensor<uint16_t>&)zReg0);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::LOWEST>(zReg1, (AscendC::Reg::RegTensor<uint16_t>&)zReg1);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::LOWEST>(zReg2, (AscendC::Reg::RegTensor<uint16_t>&)zReg2);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::LOWEST>(zReg3, (AscendC::Reg::RegTensor<uint16_t>&)zReg3);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::LOWEST>(zReg0, (AscendC::Reg::RegTensor<uint16_t>&)zReg0);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::LOWEST>(zReg1, (AscendC::Reg::RegTensor<uint16_t>&)zReg1);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::LOWEST>(zReg2, (AscendC::Reg::RegTensor<uint16_t>&)zReg2);
        AscendC::Reg::UnPack<uint32_t, uint16_t, AscendC::Reg::HighLowPart::LOWEST>(zReg3, (AscendC::Reg::RegTensor<uint16_t>&)zReg3);
        AscendC::Reg::StoreAlign(z + BENCH_LANE0, zReg0, mask);
        AscendC::Reg::StoreAlign(z + BENCH_LANE1, zReg1, mask);
        AscendC::Reg::StoreAlign(z + BENCH_LANE2, zReg2, mask);
        AscendC::Reg::StoreAlign(z + BENCH_LANE3, zReg3, mask);
    }
}
#endif // __NPU_ARCH__ == 3510 (cast round-trip)

__aicore__ inline void WriteRecord(AscendC::GlobalTensor<uint64_t>& out, uint32_t blockIdx, uint32_t caseId,
    uint32_t iterations, uint32_t unroll, uint32_t logicalOpsPerUnroll, uint32_t elementsPerInst, uint32_t status,
    uint64_t emptyCycles, uint64_t measuredCycles, uint64_t sink)
{
    const uint32_t offset = blockIdx * REGBASE_BENCH_WORDS;
    const uint64_t bodyCycles = measuredCycles > emptyCycles ? measuredCycles - emptyCycles : 0;
    out.SetValue(offset + REC_MAGIC, REGBASE_BENCH_MAGIC);
    out.SetValue(offset + REC_VERSION, REGBASE_BENCH_VERSION);
    out.SetValue(offset + REC_CASE_ID, caseId);
    out.SetValue(offset + REC_BLOCK_IDX, blockIdx);
    out.SetValue(offset + REC_STATUS, status);
    out.SetValue(offset + REC_ITERATIONS, iterations);
    out.SetValue(offset + REC_UNROLL, unroll);
    out.SetValue(offset + REC_LOGICAL_OPS_PER_UNROLL, logicalOpsPerUnroll);
    out.SetValue(offset + REC_ELEMENTS_PER_INST, elementsPerInst);
    out.SetValue(offset + REC_EMPTY_CYCLES, emptyCycles);
    out.SetValue(offset + REC_MEASURED_CYCLES, measuredCycles);
    out.SetValue(offset + REC_BODY_CYCLES, bodyCycles);
    out.SetValue(offset + REC_SINK, sink);
    out.SetValue(offset + REC_RESERVED0, 0);
    out.SetValue(offset + REC_RESERVED1, 0);
    out.SetValue(offset + REC_RESERVED2, 0);
}

} // namespace

extern "C" __global__ __vector__ void regbase_microbench_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR out, GM_ADDR tiling)
{
    const __gm__ RegbaseBenchTilingData* tilingData = reinterpret_cast<__gm__ RegbaseBenchTilingData*>(tiling);
    const uint32_t caseId = tilingData->caseId;
    const uint32_t iterations = tilingData->iterations;
    const uint32_t unroll = tilingData->unroll;
    const uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());

    AscendC::InitSocState();
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<uint64_t> outGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), REGBASE_BENCH_F32_BUFFER_ELEMS);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), REGBASE_BENCH_F32_BUFFER_ELEMS);
    outGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(out));

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float>(REGBASE_BENCH_F32_BUFFER_ELEMS);
    AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<float>(REGBASE_BENCH_F32_BUFFER_ELEMS);
    AscendC::LocalTensor<float> zLocal = ubAllocator.Alloc<float>(REGBASE_BENCH_F32_BUFFER_ELEMS);
    AscendC::LocalTensor<half> zHalfLocal = ubAllocator.Alloc<half>(REGBASE_BENCH_F16_BUFFER_ELEMS);

    AscendC::DataCopyPad(xLocal, xGm,
        {1, static_cast<uint16_t>(REGBASE_BENCH_F32_BUFFER_ELEMS * sizeof(float)), 0, 0}, {false, 0, 0, 0});
    AscendC::DataCopyPad(yLocal, yGm,
        {1, static_cast<uint16_t>(REGBASE_BENCH_F32_BUFFER_ELEMS * sizeof(float)), 0, 0}, {false, 0, 0, 0});
    AscendC::DataCopyPad(zLocal, xGm,
        {1, static_cast<uint16_t>(REGBASE_BENCH_F32_BUFFER_ELEMS * sizeof(float)), 0, 0}, {false, 0, 0, 0});
    AscendC::PipeBarrier<PIPE_ALL>();

    uint64_t emptyCycles = 0;
    uint64_t measuredCycles = 0;
    uint64_t sink = 0;
    uint32_t status = BENCH_STATUS_OK;
    uint32_t elementsPerInst = REGBASE_BENCH_F32_ELEMS;
    uint32_t logicalOpsPerUnroll = 1;

    __ubuf__ float* xPtr = reinterpret_cast<__ubuf__ float*>(xLocal.GetPhyAddr());
    __ubuf__ float* yPtr = reinterpret_cast<__ubuf__ float*>(yLocal.GetPhyAddr());
    __ubuf__ float* zPtr = reinterpret_cast<__ubuf__ float*>(zLocal.GetPhyAddr());
    __ubuf__ half* xHalfPtr = reinterpret_cast<__ubuf__ half*>(xLocal.GetPhyAddr());
    __ubuf__ half* zHalfPtr = reinterpret_cast<__ubuf__ half*>(zHalfLocal.GetPhyAddr());
    __ubuf__ uint32_t* xU32Ptr = reinterpret_cast<__ubuf__ uint32_t*>(xLocal.GetPhyAddr());
    __ubuf__ uint32_t* yU32Ptr = reinterpret_cast<__ubuf__ uint32_t*>(yLocal.GetPhyAddr());
    __ubuf__ uint32_t* zU32Ptr = reinterpret_cast<__ubuf__ uint32_t*>(zLocal.GetPhyAddr());
    __ubuf__ int32_t* xS32Ptr = reinterpret_cast<__ubuf__ int32_t*>(xLocal.GetPhyAddr());
    __ubuf__ int32_t* yS32Ptr = reinterpret_cast<__ubuf__ int32_t*>(yLocal.GetPhyAddr());
    __ubuf__ int32_t* zS32Ptr = reinterpret_cast<__ubuf__ int32_t*>(zLocal.GetPhyAddr());
    __ubuf__ uint16_t* xU16Ptr = reinterpret_cast<__ubuf__ uint16_t*>(xLocal.GetPhyAddr());
    __ubuf__ uint16_t* zU16Ptr = reinterpret_cast<__ubuf__ uint16_t*>(zLocal.GetPhyAddr());

    AscendC::PipeBarrier<PIPE_ALL>();
    int64_t emptyStart = AscendC::GetSystemCycle();
    asc_vf_call<EmptyFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
    AscendC::PipeBarrier<PIPE_ALL>();
    int64_t emptyEnd = AscendC::GetSystemCycle();

    AscendC::PipeBarrier<PIPE_ALL>();
    int64_t measuredStart = AscendC::GetSystemCycle();
    switch (caseId) {
        case BENCH_ADD_FP32:
            asc_vf_call<AddFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_MUL_FP32:
            asc_vf_call<MulFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_CAST_F32_TO_F16:
            status = BENCH_STATUS_UNSUPPORTED_CASE;
            break;
        case BENCH_MULADDDST_FP32:
            asc_vf_call<MulAddDstFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_SQRT_FP32:
            asc_vf_call<SqrtFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_REDUCESUM_FP32:
            asc_vf_call<ReduceSumFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_SUB_FP32:
            asc_vf_call<SubFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_MAX_FP32:
            asc_vf_call<MaxFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_MIN_FP32:
            asc_vf_call<MinFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_ABS_FP32:
            asc_vf_call<AbsFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_RELU_FP32:
            asc_vf_call<ReluFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_NEG_FP32:
            asc_vf_call<NegFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_EXP_FP32:
            asc_vf_call<ExpFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_EXP_FP16:
            elementsPerInst = REGBASE_BENCH_F16_ELEMS;
            asc_vf_call<ExpFp16Vf>(xHalfPtr, zHalfPtr, iterations, unroll);
            break;
        case BENCH_LOG_FP32:
            asc_vf_call<LogFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_LOG2_FP32:
            asc_vf_call<Log2Fp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_LOG10_FP32:
            asc_vf_call<Log10Fp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_LEAKYRELU_FP32:
            asc_vf_call<LeakyReluFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_PRELU_FP32:
            asc_vf_call<PreluFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_ABSSUB_FP32:
            asc_vf_call<AbsSubFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_EXPSUB_FP32:
            asc_vf_call<ExpSubFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_EXP_THEN_SUB_FP32:
            logicalOpsPerUnroll = 2;
            asc_vf_call<ExpThenSubFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_MULSCAST_F32_TO_F16:
            asc_vf_call<MulsCastF32ToF16Vf>(xPtr, zHalfPtr, iterations, unroll);
            break;
        case BENCH_ADDC_U32:
            asc_vf_call<AddCU32Vf>(xU32Ptr, yU32Ptr, zU32Ptr, iterations, unroll);
            break;
        case BENCH_SUBC_U32:
            asc_vf_call<SubCU32Vf>(xU32Ptr, yU32Ptr, zU32Ptr, iterations, unroll);
            break;
        case BENCH_INTERLEAVE_U32:
            asc_vf_call<InterleaveU32Vf>(xU32Ptr, yU32Ptr, zU32Ptr, iterations, unroll);
            break;
        case BENCH_DEINTERLEAVE_U32:
            asc_vf_call<DeInterleaveU32Vf>(xU32Ptr, yU32Ptr, zU32Ptr, iterations, unroll);
            break;
        case BENCH_PACK_U32_TO_U16:
            asc_vf_call<PackU32ToU16Vf>(xU32Ptr, zU16Ptr, iterations, unroll);
            break;
        case BENCH_UNPACK_U16_TO_U32:
            asc_vf_call<UnPackU16ToU32Vf>(xU16Ptr, zU32Ptr, iterations, unroll);
            break;
        case BENCH_ADD_U32:
            asc_vf_call<AddU32Vf>(xU32Ptr, yU32Ptr, zU32Ptr, iterations, unroll);
            break;
        case BENCH_ADD_S32:
            asc_vf_call<AddS32Vf>(xS32Ptr, yS32Ptr, zS32Ptr, iterations, unroll);
            break;
        case BENCH_EXP_ADD2_FP32:
            logicalOpsPerUnroll = 3;
            asc_vf_call<ExpAdd2Fp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_EXP_ADD4_FP32:
            logicalOpsPerUnroll = 5;
            asc_vf_call<ExpAdd4Fp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_EXP_ADD8_FP32:
            logicalOpsPerUnroll = 9;
            asc_vf_call<ExpAdd8Fp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_EXP_MUL_ADD_FP32:
            logicalOpsPerUnroll = 3;
            asc_vf_call<ExpMulAddFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_SQRT_ADD4_FP32:
            logicalOpsPerUnroll = 5;
            asc_vf_call<SqrtAdd4Fp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_EXP_ADD4_INDEP_FP32:
            logicalOpsPerUnroll = 5;
            asc_vf_call<ExpAdd4IndepFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_EXP_ADD8_INDEP_FP32:
            logicalOpsPerUnroll = 9;
            asc_vf_call<ExpAdd8IndepFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_DIV_FP32:
            asc_vf_call<DivFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_REDUCEMAX_FP32:
            asc_vf_call<ReduceMaxFp32Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        case BENCH_CAST_RT_F16:
            logicalOpsPerUnroll = 2;
            asc_vf_call<CastRoundtripF16Vf>(xPtr, yPtr, zPtr, iterations, unroll);
            break;
        default:
            status = BENCH_STATUS_UNSUPPORTED_CASE;
            break;
    }
    AscendC::PipeBarrier<PIPE_ALL>();
    int64_t measuredEnd = AscendC::GetSystemCycle();

    emptyCycles = emptyEnd > emptyStart ? static_cast<uint64_t>(emptyEnd - emptyStart) : 0;
    measuredCycles = measuredEnd > measuredStart ? static_cast<uint64_t>(measuredEnd - measuredStart) : 0;
    sink = static_cast<uint64_t>(caseId) ^ static_cast<uint64_t>(iterations) ^ static_cast<uint64_t>(unroll);
    WriteRecord(outGm, blockIdx, caseId, iterations, BENCH_FIXED_UNROLL, logicalOpsPerUnroll, elementsPerInst, status,
        emptyCycles, measuredCycles, sink);
}
