#include "kernel_operator.h"
#include "reg_compute/kernel_reg_compute_intf.h"
#include "regbase_microbench_tiling.h"

// CastTrait/RegLayout/etc. are defined only in the device compilation pass
// (__NPU_ARCH__ == 3510); guard so the host pass of this .asc still compiles.
#if (__NPU_ARCH__ == 3510)
constexpr AscendC::Reg::CastTrait g_castZeroing = {
    AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::NO_SAT,
    AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::CAST_RINT};
#endif

namespace {

constexpr uint32_t BENCH_FIXED_UNROLL = 16;
constexpr uint32_t BENCH_LANE0 = 0;
constexpr uint32_t BENCH_LANE1 = REGBASE_BENCH_F32_ELEMS;
constexpr uint32_t BENCH_LANE2 = REGBASE_BENCH_F32_ELEMS * 2;
constexpr uint32_t BENCH_LANE3 = REGBASE_BENCH_F32_ELEMS * 3;
constexpr uint32_t BENCH_U16_ELEMS = 128;
constexpr uint32_t BENCH_U16_LANE0 = 0;
constexpr uint32_t BENCH_U16_LANE1 = BENCH_U16_ELEMS;
constexpr uint32_t BENCH_U16_LANE2 = BENCH_U16_ELEMS * 2;
constexpr uint32_t BENCH_U16_LANE3 = BENCH_U16_ELEMS * 3;
constexpr uint32_t BENCH_F16_LANE0 = 0;
constexpr uint32_t BENCH_F16_LANE1 = REGBASE_BENCH_F16_ELEMS;
constexpr uint32_t BENCH_F16_LANE2 = REGBASE_BENCH_F16_ELEMS * 2;
constexpr uint32_t BENCH_F16_LANE3 = REGBASE_BENCH_F16_ELEMS * 3;

#define BENCH_BINARY_SLOT(OP, DST, LANE)                            \
    do {                                                            \
        AscendC::Reg::OP((DST), (DST), yReg, mask);                 \
    } while (0)

#define BENCH_MULADDDST_SLOT(DST, LANE)                             \
    do {                                                            \
        AscendC::Reg::MulAddDst((DST), xReg, yReg, mask);           \
    } while (0)

#define BENCH_UNARY_SLOT(OP, DST, LANE)                             \
    do {                                                            \
        AscendC::Reg::OP((DST), (DST), mask);                       \
    } while (0)

#define BENCH_REDUCE_SUM_SLOT(DST, LANE)                            \
    do {                                                            \
        AscendC::Reg::Reduce<AscendC::Reg::ReduceType::SUM>((DST), (DST), mask); \
    } while (0)

#define BENCH_LEAKYRELU_SLOT(DST, LANE)                             \
    do {                                                            \
        AscendC::Reg::LeakyRelu((DST), (DST), scalarValue, mask);    \
    } while (0)

#define BENCH_EXPSUB_SLOT(DST, LANE)                                \
    do {                                                            \
        AscendC::Reg::ExpSub<float, float, AscendC::Reg::RegLayout::ZERO, \
            AscendC::Reg::MaskMergeMode::ZEROING>((DST), (DST), yReg, mask); \
    } while (0)

#define BENCH_MULSCAST_SLOT(DST, SRC, LANE)                         \
    do {                                                            \
        AscendC::Reg::MulsCast<half, float, float, AscendC::Reg::RegLayout::ZERO>((DST), (SRC), 0.5f, mask); \
    } while (0)

#define BENCH_LOAD_GROUP()                                          \
    do {                                                            \
        AscendC::Reg::LoadAlign(xReg, x + BENCH_LANE0);             \
        AscendC::Reg::LoadAlign(yReg, y + BENCH_LANE0);             \
        AscendC::Reg::LoadAlign(zReg0, z + BENCH_LANE0);            \
        AscendC::Reg::LoadAlign(zReg1, z + BENCH_LANE1);            \
        AscendC::Reg::LoadAlign(zReg2, z + BENCH_LANE2);            \
        AscendC::Reg::LoadAlign(zReg3, z + BENCH_LANE3);            \
    } while (0)

#define BENCH_STORE_GROUP()                                         \
    do {                                                            \
        AscendC::Reg::StoreAlign(z + BENCH_LANE0, zReg0, mask);     \
        AscendC::Reg::StoreAlign(z + BENCH_LANE1, zReg1, mask);     \
        AscendC::Reg::StoreAlign(z + BENCH_LANE2, zReg2, mask);     \
        AscendC::Reg::StoreAlign(z + BENCH_LANE3, zReg3, mask);     \
    } while (0)

__simd_vf__ inline void EmptyFp32Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        BENCH_LOAD_GROUP();
        BENCH_STORE_GROUP();
    }
}

__simd_vf__ inline void AddFp32Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        BENCH_LOAD_GROUP();
        BENCH_BINARY_SLOT(Add, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Add, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Add, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Add, zReg3, BENCH_LANE3);
        BENCH_BINARY_SLOT(Add, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Add, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Add, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Add, zReg3, BENCH_LANE3);
        BENCH_BINARY_SLOT(Add, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Add, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Add, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Add, zReg3, BENCH_LANE3);
        BENCH_BINARY_SLOT(Add, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Add, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Add, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Add, zReg3, BENCH_LANE3);
        BENCH_STORE_GROUP();
    }
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);
    AscendC::Reg::StoreAlign(z, zReg0, mask);
}

__simd_vf__ inline void MulFp32Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        BENCH_LOAD_GROUP();
        BENCH_BINARY_SLOT(Mul, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Mul, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Mul, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Mul, zReg3, BENCH_LANE3);
        BENCH_BINARY_SLOT(Mul, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Mul, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Mul, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Mul, zReg3, BENCH_LANE3);
        BENCH_BINARY_SLOT(Mul, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Mul, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Mul, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Mul, zReg3, BENCH_LANE3);
        BENCH_BINARY_SLOT(Mul, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Mul, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Mul, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Mul, zReg3, BENCH_LANE3);
        BENCH_STORE_GROUP();
    }
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);
    AscendC::Reg::StoreAlign(z, zReg0, mask);
}

__simd_vf__ inline void MulAddDstFp32Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        BENCH_LOAD_GROUP();
        BENCH_MULADDDST_SLOT(zReg0, BENCH_LANE0);
        BENCH_MULADDDST_SLOT(zReg1, BENCH_LANE1);
        BENCH_MULADDDST_SLOT(zReg2, BENCH_LANE2);
        BENCH_MULADDDST_SLOT(zReg3, BENCH_LANE3);
        BENCH_MULADDDST_SLOT(zReg0, BENCH_LANE0);
        BENCH_MULADDDST_SLOT(zReg1, BENCH_LANE1);
        BENCH_MULADDDST_SLOT(zReg2, BENCH_LANE2);
        BENCH_MULADDDST_SLOT(zReg3, BENCH_LANE3);
        BENCH_MULADDDST_SLOT(zReg0, BENCH_LANE0);
        BENCH_MULADDDST_SLOT(zReg1, BENCH_LANE1);
        BENCH_MULADDDST_SLOT(zReg2, BENCH_LANE2);
        BENCH_MULADDDST_SLOT(zReg3, BENCH_LANE3);
        BENCH_MULADDDST_SLOT(zReg0, BENCH_LANE0);
        BENCH_MULADDDST_SLOT(zReg1, BENCH_LANE1);
        BENCH_MULADDDST_SLOT(zReg2, BENCH_LANE2);
        BENCH_MULADDDST_SLOT(zReg3, BENCH_LANE3);
        BENCH_STORE_GROUP();
    }
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);
    AscendC::Reg::StoreAlign(z, zReg0, mask);
}

__simd_vf__ inline void SqrtFp32Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        BENCH_LOAD_GROUP();
        BENCH_UNARY_SLOT(Sqrt, zReg0, BENCH_LANE0);
        BENCH_UNARY_SLOT(Sqrt, zReg1, BENCH_LANE1);
        BENCH_UNARY_SLOT(Sqrt, zReg2, BENCH_LANE2);
        BENCH_UNARY_SLOT(Sqrt, zReg3, BENCH_LANE3);
        BENCH_UNARY_SLOT(Sqrt, zReg0, BENCH_LANE0);
        BENCH_UNARY_SLOT(Sqrt, zReg1, BENCH_LANE1);
        BENCH_UNARY_SLOT(Sqrt, zReg2, BENCH_LANE2);
        BENCH_UNARY_SLOT(Sqrt, zReg3, BENCH_LANE3);
        BENCH_UNARY_SLOT(Sqrt, zReg0, BENCH_LANE0);
        BENCH_UNARY_SLOT(Sqrt, zReg1, BENCH_LANE1);
        BENCH_UNARY_SLOT(Sqrt, zReg2, BENCH_LANE2);
        BENCH_UNARY_SLOT(Sqrt, zReg3, BENCH_LANE3);
        BENCH_UNARY_SLOT(Sqrt, zReg0, BENCH_LANE0);
        BENCH_UNARY_SLOT(Sqrt, zReg1, BENCH_LANE1);
        BENCH_UNARY_SLOT(Sqrt, zReg2, BENCH_LANE2);
        BENCH_UNARY_SLOT(Sqrt, zReg3, BENCH_LANE3);
        BENCH_STORE_GROUP();
    }
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);
    AscendC::Reg::StoreAlign(z, zReg0, mask);
}

__simd_vf__ inline void ReduceSumFp32Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        BENCH_LOAD_GROUP();
        BENCH_REDUCE_SUM_SLOT(zReg0, BENCH_LANE0);
        BENCH_REDUCE_SUM_SLOT(zReg1, BENCH_LANE1);
        BENCH_REDUCE_SUM_SLOT(zReg2, BENCH_LANE2);
        BENCH_REDUCE_SUM_SLOT(zReg3, BENCH_LANE3);
        BENCH_REDUCE_SUM_SLOT(zReg0, BENCH_LANE0);
        BENCH_REDUCE_SUM_SLOT(zReg1, BENCH_LANE1);
        BENCH_REDUCE_SUM_SLOT(zReg2, BENCH_LANE2);
        BENCH_REDUCE_SUM_SLOT(zReg3, BENCH_LANE3);
        BENCH_REDUCE_SUM_SLOT(zReg0, BENCH_LANE0);
        BENCH_REDUCE_SUM_SLOT(zReg1, BENCH_LANE1);
        BENCH_REDUCE_SUM_SLOT(zReg2, BENCH_LANE2);
        BENCH_REDUCE_SUM_SLOT(zReg3, BENCH_LANE3);
        BENCH_REDUCE_SUM_SLOT(zReg0, BENCH_LANE0);
        BENCH_REDUCE_SUM_SLOT(zReg1, BENCH_LANE1);
        BENCH_REDUCE_SUM_SLOT(zReg2, BENCH_LANE2);
        BENCH_REDUCE_SUM_SLOT(zReg3, BENCH_LANE3);
        BENCH_STORE_GROUP();
    }
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);
    AscendC::Reg::StoreAlign(z, zReg0, mask);
}

#define BENCH_DEFINE_BINARY_FP32_VF(FUNC_NAME, OP_NAME)             \
__simd_vf__ inline void FUNC_NAME(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z, \
    uint32_t iterations, uint32_t unroll)                           \
{                                                                   \
    (void)unroll;                                                   \
    AscendC::Reg::RegTensor<float> xReg;                            \
    AscendC::Reg::RegTensor<float> yReg;                            \
    AscendC::Reg::RegTensor<float> zReg0;                           \
    AscendC::Reg::RegTensor<float> zReg1;                           \
    AscendC::Reg::RegTensor<float> zReg2;                           \
    AscendC::Reg::RegTensor<float> zReg3;                           \
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>(); \
    for (uint32_t i = 0; i < iterations; ++i) {                     \
        BENCH_LOAD_GROUP();                                         \
        BENCH_BINARY_SLOT(OP_NAME, zReg0, BENCH_LANE0);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg1, BENCH_LANE1);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg2, BENCH_LANE2);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg3, BENCH_LANE3);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg0, BENCH_LANE0);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg1, BENCH_LANE1);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg2, BENCH_LANE2);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg3, BENCH_LANE3);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg0, BENCH_LANE0);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg1, BENCH_LANE1);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg2, BENCH_LANE2);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg3, BENCH_LANE3);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg0, BENCH_LANE0);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg1, BENCH_LANE1);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg2, BENCH_LANE2);             \
        BENCH_BINARY_SLOT(OP_NAME, zReg3, BENCH_LANE3);             \
        BENCH_STORE_GROUP();                                        \
    }                                                               \
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);                   \
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);                   \
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);                   \
    AscendC::Reg::StoreAlign(z, zReg0, mask);                       \
}

#define BENCH_DEFINE_UNARY_FP32_VF(FUNC_NAME, OP_NAME)              \
__simd_vf__ inline void FUNC_NAME(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z, \
    uint32_t iterations, uint32_t unroll)                           \
{                                                                   \
    (void)unroll;                                                   \
    AscendC::Reg::RegTensor<float> xReg;                            \
    AscendC::Reg::RegTensor<float> yReg;                            \
    AscendC::Reg::RegTensor<float> zReg0;                           \
    AscendC::Reg::RegTensor<float> zReg1;                           \
    AscendC::Reg::RegTensor<float> zReg2;                           \
    AscendC::Reg::RegTensor<float> zReg3;                           \
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>(); \
    for (uint32_t i = 0; i < iterations; ++i) {                     \
        BENCH_LOAD_GROUP();                                         \
        BENCH_UNARY_SLOT(OP_NAME, zReg0, BENCH_LANE0);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg1, BENCH_LANE1);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg2, BENCH_LANE2);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg3, BENCH_LANE3);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg0, BENCH_LANE0);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg1, BENCH_LANE1);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg2, BENCH_LANE2);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg3, BENCH_LANE3);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg0, BENCH_LANE0);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg1, BENCH_LANE1);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg2, BENCH_LANE2);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg3, BENCH_LANE3);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg0, BENCH_LANE0);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg1, BENCH_LANE1);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg2, BENCH_LANE2);              \
        BENCH_UNARY_SLOT(OP_NAME, zReg3, BENCH_LANE3);              \
        BENCH_STORE_GROUP();                                        \
    }                                                               \
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);                   \
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);                   \
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);                   \
    AscendC::Reg::StoreAlign(z, zReg0, mask);                       \
}

BENCH_DEFINE_BINARY_FP32_VF(SubFp32Vf, Sub)
BENCH_DEFINE_BINARY_FP32_VF(MaxFp32Vf, Max)
BENCH_DEFINE_BINARY_FP32_VF(MinFp32Vf, Min)
