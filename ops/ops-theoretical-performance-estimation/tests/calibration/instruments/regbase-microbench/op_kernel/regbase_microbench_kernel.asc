BENCH_DEFINE_UNARY_FP32_VF(ReluFp32Vf, Relu)
BENCH_DEFINE_UNARY_FP32_VF(NegFp32Vf, Neg)
BENCH_DEFINE_UNARY_FP32_VF(ExpFp32Vf, Exp)
BENCH_DEFINE_UNARY_FP32_VF(LogFp32Vf, Log)
BENCH_DEFINE_UNARY_FP32_VF(Log2Fp32Vf, Log2)
BENCH_DEFINE_UNARY_FP32_VF(Log10Fp32Vf, Log10)
BENCH_DEFINE_BINARY_FP32_VF(PreluFp32Vf, Prelu)
BENCH_DEFINE_BINARY_FP32_VF(AbsSubFp32Vf, AbsSub)
