#define BENCH_REDUCE_MAX_SLOT(DST, LANE)                            \
    do {                                                            \
        AscendC::Reg::Reduce<AscendC::Reg::ReduceType::MAX>((DST), (DST), mask); \
    } while (0)

// NOTE: vrsqrt/vrec single-instruction primitives are compiler-disabled on
// dav_3510 (intrinsics guard: __NPU_ARCH__ != 3510). On A5, Rsqrt/Reciprocal are
// composite (Sqrt fast-inverse + Newton-Raphson / Div), not single ops, so they
// are intentionally NOT benched here as primitives.

#if (__NPU_ARCH__ == 3510)
// Cast throughput via an f32<->fp16 round-trip chain: each cast depends on the
// previous (no dead-cast elimination), in-place on z (no loop hoisting). Per
// slot = 2 casts (1 narrow f32->f16 + 1 widen f16->f32), both fast-path
// conversions (expected 1-cycle / 2.0 issue per the conversion_2slot_t1 model).
// Uses Cast's default CastTrait (rounding/layout irrelevant for throughput).
#define BENCH_CAST_RT16_SLOT(F, H)                                  \
    do {                                                            \
        AscendC::Reg::Cast<half, float, g_castZeroing>((H), (F), mask);   \
        AscendC::Reg::Cast<float, half, g_castZeroing>((F), (H), mask);   \
    } while (0)

__simd_vf__ inline void CastRoundtripF16Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll; (void)x; (void)y;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::RegTensor<half> hReg0;
    AscendC::Reg::RegTensor<half> hReg1;
    AscendC::Reg::RegTensor<half> hReg2;
    AscendC::Reg::RegTensor<half> hReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        AscendC::Reg::LoadAlign(zReg0, z + BENCH_LANE0);
        AscendC::Reg::LoadAlign(zReg1, z + BENCH_LANE1);
        AscendC::Reg::LoadAlign(zReg2, z + BENCH_LANE2);
        AscendC::Reg::LoadAlign(zReg3, z + BENCH_LANE3);
        BENCH_CAST_RT16_SLOT(zReg0, hReg0); BENCH_CAST_RT16_SLOT(zReg1, hReg1);
        BENCH_CAST_RT16_SLOT(zReg2, hReg2); BENCH_CAST_RT16_SLOT(zReg3, hReg3);
        BENCH_CAST_RT16_SLOT(zReg0, hReg0); BENCH_CAST_RT16_SLOT(zReg1, hReg1);
        BENCH_CAST_RT16_SLOT(zReg2, hReg2); BENCH_CAST_RT16_SLOT(zReg3, hReg3);
        BENCH_CAST_RT16_SLOT(zReg0, hReg0); BENCH_CAST_RT16_SLOT(zReg1, hReg1);
        BENCH_CAST_RT16_SLOT(zReg2, hReg2); BENCH_CAST_RT16_SLOT(zReg3, hReg3);
        BENCH_CAST_RT16_SLOT(zReg0, hReg0); BENCH_CAST_RT16_SLOT(zReg1, hReg1);
        BENCH_CAST_RT16_SLOT(zReg2, hReg2); BENCH_CAST_RT16_SLOT(zReg3, hReg3);
        AscendC::Reg::StoreAlign(z + BENCH_LANE0, zReg0, mask);
        AscendC::Reg::StoreAlign(z + BENCH_LANE1, zReg1, mask);
        AscendC::Reg::StoreAlign(z + BENCH_LANE2, zReg2, mask);
        AscendC::Reg::StoreAlign(z + BENCH_LANE3, zReg3, mask);
    }
}

__simd_vf__ inline void ReduceMaxFp32Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        BENCH_LOAD_GROUP();
        BENCH_REDUCE_MAX_SLOT(zReg0, BENCH_LANE0);
        BENCH_REDUCE_MAX_SLOT(zReg1, BENCH_LANE1);
        BENCH_REDUCE_MAX_SLOT(zReg2, BENCH_LANE2);
        BENCH_REDUCE_MAX_SLOT(zReg3, BENCH_LANE3);
        BENCH_REDUCE_MAX_SLOT(zReg0, BENCH_LANE0);
        BENCH_REDUCE_MAX_SLOT(zReg1, BENCH_LANE1);
        BENCH_REDUCE_MAX_SLOT(zReg2, BENCH_LANE2);
        BENCH_REDUCE_MAX_SLOT(zReg3, BENCH_LANE3);
        BENCH_REDUCE_MAX_SLOT(zReg0, BENCH_LANE0);
        BENCH_REDUCE_MAX_SLOT(zReg1, BENCH_LANE1);
        BENCH_REDUCE_MAX_SLOT(zReg2, BENCH_LANE2);
        BENCH_REDUCE_MAX_SLOT(zReg3, BENCH_LANE3);
        BENCH_REDUCE_MAX_SLOT(zReg0, BENCH_LANE0);
        BENCH_REDUCE_MAX_SLOT(zReg1, BENCH_LANE1);
        BENCH_REDUCE_MAX_SLOT(zReg2, BENCH_LANE2);
        BENCH_REDUCE_MAX_SLOT(zReg3, BENCH_LANE3);
        BENCH_STORE_GROUP();
    }
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);
    AscendC::Reg::StoreAlign(z, zReg0, mask);
}

__simd_vf__ inline void LeakyReluFp32Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    constexpr float scalarValue = 0.125f;
    for (uint32_t i = 0; i < iterations; ++i) {
        BENCH_LOAD_GROUP();
        BENCH_LEAKYRELU_SLOT(zReg0, BENCH_LANE0);
        BENCH_LEAKYRELU_SLOT(zReg1, BENCH_LANE1);
        BENCH_LEAKYRELU_SLOT(zReg2, BENCH_LANE2);
        BENCH_LEAKYRELU_SLOT(zReg3, BENCH_LANE3);
        BENCH_LEAKYRELU_SLOT(zReg0, BENCH_LANE0);
        BENCH_LEAKYRELU_SLOT(zReg1, BENCH_LANE1);
        BENCH_LEAKYRELU_SLOT(zReg2, BENCH_LANE2);
        BENCH_LEAKYRELU_SLOT(zReg3, BENCH_LANE3);
        BENCH_LEAKYRELU_SLOT(zReg0, BENCH_LANE0);
        BENCH_LEAKYRELU_SLOT(zReg1, BENCH_LANE1);
        BENCH_LEAKYRELU_SLOT(zReg2, BENCH_LANE2);
        BENCH_LEAKYRELU_SLOT(zReg3, BENCH_LANE3);
        BENCH_LEAKYRELU_SLOT(zReg0, BENCH_LANE0);
        BENCH_LEAKYRELU_SLOT(zReg1, BENCH_LANE1);
        BENCH_LEAKYRELU_SLOT(zReg2, BENCH_LANE2);
        BENCH_LEAKYRELU_SLOT(zReg3, BENCH_LANE3);
        BENCH_STORE_GROUP();
    }
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);
    AscendC::Reg::StoreAlign(z, zReg0, mask);
}

__simd_vf__ inline void ExpSubFp32Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        BENCH_LOAD_GROUP();
        BENCH_EXPSUB_SLOT(zReg0, BENCH_LANE0);
        BENCH_EXPSUB_SLOT(zReg1, BENCH_LANE1);
        BENCH_EXPSUB_SLOT(zReg2, BENCH_LANE2);
        BENCH_EXPSUB_SLOT(zReg3, BENCH_LANE3);
        BENCH_EXPSUB_SLOT(zReg0, BENCH_LANE0);
        BENCH_EXPSUB_SLOT(zReg1, BENCH_LANE1);
        BENCH_EXPSUB_SLOT(zReg2, BENCH_LANE2);
        BENCH_EXPSUB_SLOT(zReg3, BENCH_LANE3);
        BENCH_EXPSUB_SLOT(zReg0, BENCH_LANE0);
        BENCH_EXPSUB_SLOT(zReg1, BENCH_LANE1);
        BENCH_EXPSUB_SLOT(zReg2, BENCH_LANE2);
        BENCH_EXPSUB_SLOT(zReg3, BENCH_LANE3);
        BENCH_EXPSUB_SLOT(zReg0, BENCH_LANE0);
        BENCH_EXPSUB_SLOT(zReg1, BENCH_LANE1);
        BENCH_EXPSUB_SLOT(zReg2, BENCH_LANE2);
        BENCH_EXPSUB_SLOT(zReg3, BENCH_LANE3);
        BENCH_STORE_GROUP();
    }
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);
    AscendC::Reg::StoreAlign(z, zReg0, mask);
}

__simd_vf__ inline void ExpThenSubFp32Vf(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z,
    uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<float> xReg;
    AscendC::Reg::RegTensor<float> yReg;
    AscendC::Reg::RegTensor<float> zReg0;
    AscendC::Reg::RegTensor<float> zReg1;
    AscendC::Reg::RegTensor<float> zReg2;
    AscendC::Reg::RegTensor<float> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        BENCH_LOAD_GROUP();
        BENCH_UNARY_SLOT(Exp, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Sub, zReg0, BENCH_LANE0);
        BENCH_UNARY_SLOT(Exp, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Sub, zReg1, BENCH_LANE1);
        BENCH_UNARY_SLOT(Exp, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Sub, zReg2, BENCH_LANE2);
        BENCH_UNARY_SLOT(Exp, zReg3, BENCH_LANE3);
        BENCH_BINARY_SLOT(Sub, zReg3, BENCH_LANE3);
        BENCH_UNARY_SLOT(Exp, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Sub, zReg0, BENCH_LANE0);
        BENCH_UNARY_SLOT(Exp, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Sub, zReg1, BENCH_LANE1);
        BENCH_UNARY_SLOT(Exp, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Sub, zReg2, BENCH_LANE2);
        BENCH_UNARY_SLOT(Exp, zReg3, BENCH_LANE3);
        BENCH_BINARY_SLOT(Sub, zReg3, BENCH_LANE3);
        BENCH_UNARY_SLOT(Exp, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Sub, zReg0, BENCH_LANE0);
        BENCH_UNARY_SLOT(Exp, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Sub, zReg1, BENCH_LANE1);
        BENCH_UNARY_SLOT(Exp, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Sub, zReg2, BENCH_LANE2);
        BENCH_UNARY_SLOT(Exp, zReg3, BENCH_LANE3);
        BENCH_BINARY_SLOT(Sub, zReg3, BENCH_LANE3);
        BENCH_UNARY_SLOT(Exp, zReg0, BENCH_LANE0);
        BENCH_BINARY_SLOT(Sub, zReg0, BENCH_LANE0);
        BENCH_UNARY_SLOT(Exp, zReg1, BENCH_LANE1);
        BENCH_BINARY_SLOT(Sub, zReg1, BENCH_LANE1);
        BENCH_UNARY_SLOT(Exp, zReg2, BENCH_LANE2);
        BENCH_BINARY_SLOT(Sub, zReg2, BENCH_LANE2);
        BENCH_UNARY_SLOT(Exp, zReg3, BENCH_LANE3);
        BENCH_BINARY_SLOT(Sub, zReg3, BENCH_LANE3);
        BENCH_STORE_GROUP();
    }
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);
    AscendC::Reg::StoreAlign(z, zReg0, mask);
}

// Mixed transcendental + ALU flows for overlap-model calibration.
// Each group does 1 Exp (or Sqrt) followed by k dependent ALU ops on the same
// register; groups cycle across 4 lanes for cross-group ILP, 16 groups / iter.
#define BENCH_EXPADD2_SLOT(DST)                                     \
    do {                                                            \
        AscendC::Reg::Exp((DST), (DST), mask);                      \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
    } while (0)

#define BENCH_EXPADD4_SLOT(DST)                                     \
    do {                                                            \
        AscendC::Reg::Exp((DST), (DST), mask);                      \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
    } while (0)

#define BENCH_EXPADD8_SLOT(DST)                                     \
    do {                                                            \
        AscendC::Reg::Exp((DST), (DST), mask);                      \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
    } while (0)

#define BENCH_EXPMULADD_SLOT(DST)                                   \
    do {                                                            \
        AscendC::Reg::Exp((DST), (DST), mask);                      \
        AscendC::Reg::Mul((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
    } while (0)

#define BENCH_SQRTADD4_SLOT(DST)                                    \
    do {                                                            \
        AscendC::Reg::Sqrt((DST), (DST), mask);                     \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
        AscendC::Reg::Add((DST), (DST), yReg, mask);                \
    } while (0)

#define BENCH_DEFINE_MIXED_FP32_VF(FUNC_NAME, GROUP_SLOT)           \
__simd_vf__ inline void FUNC_NAME(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z, \
    uint32_t iterations, uint32_t unroll)                           \
{                                                                   \
    (void)unroll;                                                   \
    AscendC::Reg::RegTensor<float> xReg;                            \
    AscendC::Reg::RegTensor<float> yReg;                            \
    AscendC::Reg::RegTensor<float> zReg0;                           \
    AscendC::Reg::RegTensor<float> zReg1;                           \
    AscendC::Reg::RegTensor<float> zReg2;                           \
    AscendC::Reg::RegTensor<float> zReg3;                           \
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>(); \
    for (uint32_t i = 0; i < iterations; ++i) {                     \
        BENCH_LOAD_GROUP();                                         \
        GROUP_SLOT(zReg0); GROUP_SLOT(zReg1); GROUP_SLOT(zReg2); GROUP_SLOT(zReg3); \
        GROUP_SLOT(zReg0); GROUP_SLOT(zReg1); GROUP_SLOT(zReg2); GROUP_SLOT(zReg3); \
        GROUP_SLOT(zReg0); GROUP_SLOT(zReg1); GROUP_SLOT(zReg2); GROUP_SLOT(zReg3); \
        GROUP_SLOT(zReg0); GROUP_SLOT(zReg1); GROUP_SLOT(zReg2); GROUP_SLOT(zReg3); \
        BENCH_STORE_GROUP();                                        \
    }                                                               \
    AscendC::Reg::Add(zReg0, zReg0, zReg1, mask);                   \
    AscendC::Reg::Add(zReg2, zReg2, zReg3, mask);                   \
    AscendC::Reg::Add(zReg0, zReg0, zReg2, mask);                   \
    AscendC::Reg::StoreAlign(z, zReg0, mask);                       \
}

BENCH_DEFINE_MIXED_FP32_VF(ExpAdd2Fp32Vf, BENCH_EXPADD2_SLOT)
BENCH_DEFINE_MIXED_FP32_VF(ExpAdd4Fp32Vf, BENCH_EXPADD4_SLOT)
BENCH_DEFINE_MIXED_FP32_VF(ExpAdd8Fp32Vf, BENCH_EXPADD8_SLOT)
BENCH_DEFINE_MIXED_FP32_VF(ExpMulAddFp32Vf, BENCH_EXPMULADD_SLOT)
BENCH_DEFINE_MIXED_FP32_VF(SqrtAdd4Fp32Vf, BENCH_SQRTADD4_SLOT)

// Independent-ALU mixed flow: exp runs on its own 4-lane chains while the ALU
// adds accumulate on 4 SEPARATE lanes, independent of exp and chained only
// within their own lane. This isolates pure resource-throughput overlap from
// the dependent-chain latency that the *_SLOT versions above also capture.
#define BENCH_INDEP_ADD4()                                          \
    AscendC::Reg::Add(aReg0, aReg0, yReg, mask);                    \
    AscendC::Reg::Add(aReg1, aReg1, yReg, mask);                    \
    AscendC::Reg::Add(aReg2, aReg2, yReg, mask);                    \
    AscendC::Reg::Add(aReg3, aReg3, yReg, mask)

#define BENCH_DEFINE_EXP_INDEP_FP32_VF(FUNC_NAME, ADD_ROUNDS)       \
__simd_vf__ inline void FUNC_NAME(__ubuf__ float* x, __ubuf__ float* y, __ubuf__ float* z, \
    uint32_t iterations, uint32_t unroll)                           \
{                                                                   \
    (void)unroll;                                                   \
    AscendC::Reg::RegTensor<float> yReg;                            \
    AscendC::Reg::RegTensor<float> eReg0;                           \
    AscendC::Reg::RegTensor<float> eReg1;                           \
    AscendC::Reg::RegTensor<float> eReg2;                           \
    AscendC::Reg::RegTensor<float> eReg3;                           \
    AscendC::Reg::RegTensor<float> aReg0;                           \
    AscendC::Reg::RegTensor<float> aReg1;                           \
    AscendC::Reg::RegTensor<float> aReg2;                           \
    AscendC::Reg::RegTensor<float> aReg3;                           \
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>(); \
    for (uint32_t i = 0; i < iterations; ++i) {                     \
        AscendC::Reg::LoadAlign(yReg, y + BENCH_LANE0);             \
        AscendC::Reg::LoadAlign(eReg0, z + BENCH_LANE0);            \
        AscendC::Reg::LoadAlign(eReg1, z + BENCH_LANE1);            \
        AscendC::Reg::LoadAlign(eReg2, z + BENCH_LANE2);            \
        AscendC::Reg::LoadAlign(eReg3, z + BENCH_LANE3);            \
        AscendC::Reg::LoadAlign(aReg0, x + BENCH_LANE0);            \
        AscendC::Reg::LoadAlign(aReg1, x + BENCH_LANE1);            \
        AscendC::Reg::LoadAlign(aReg2, x + BENCH_LANE2);            \
        AscendC::Reg::LoadAlign(aReg3, x + BENCH_LANE3);            \
        for (uint32_t e = 0; e < 4; ++e) {                          \
            AscendC::Reg::Exp(eReg0, eReg0, mask); ADD_ROUNDS;      \
            AscendC::Reg::Exp(eReg1, eReg1, mask); ADD_ROUNDS;      \
            AscendC::Reg::Exp(eReg2, eReg2, mask); ADD_ROUNDS;      \
            AscendC::Reg::Exp(eReg3, eReg3, mask); ADD_ROUNDS;      \
        }                                                           \
        AscendC::Reg::StoreAlign(z + BENCH_LANE0, eReg0, mask);     \
        AscendC::Reg::StoreAlign(z + BENCH_LANE1, eReg1, mask);     \
        AscendC::Reg::StoreAlign(z + BENCH_LANE2, eReg2, mask);     \
        AscendC::Reg::StoreAlign(z + BENCH_LANE3, eReg3, mask);     \
        AscendC::Reg::StoreAlign(x + BENCH_LANE0, aReg0, mask);     \
        AscendC::Reg::StoreAlign(x + BENCH_LANE1, aReg1, mask);     \
        AscendC::Reg::StoreAlign(x + BENCH_LANE2, aReg2, mask);     \
        AscendC::Reg::StoreAlign(x + BENCH_LANE3, aReg3, mask);     \
    }                                                               \
}

// k=2: 2 indep adds/exp -> issue one INDEP_ADD4 every 2 exps would skew ratio,
// so we keep 4 adds/exp (k=4) and 8 adds/exp (k=8) as the two clean points.
#define BENCH_ADD_ROUNDS_1() BENCH_INDEP_ADD4()
#define BENCH_ADD_ROUNDS_2() BENCH_INDEP_ADD4(); BENCH_INDEP_ADD4()
BENCH_DEFINE_EXP_INDEP_FP32_VF(ExpAdd4IndepFp32Vf, BENCH_ADD_ROUNDS_1())
BENCH_DEFINE_EXP_INDEP_FP32_VF(ExpAdd8IndepFp32Vf, BENCH_ADD_ROUNDS_2())

__simd_vf__ inline void ExpFp16Vf(__ubuf__ half* x, __ubuf__ half* z, uint32_t iterations, uint32_t unroll)
{
    (void)unroll;
    AscendC::Reg::RegTensor<half> zReg0;
    AscendC::Reg::RegTensor<half> zReg1;
    AscendC::Reg::RegTensor<half> zReg2;
    AscendC::Reg::RegTensor<half> zReg3;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<half, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t i = 0; i < iterations; ++i) {
        AscendC::Reg::LoadAlign(zReg0, z + BENCH_F16_LANE0);
        AscendC::Reg::LoadAlign(zReg1, z + BENCH_F16_LANE1);
        AscendC::Reg::LoadAlign(zReg2, z + BENCH_F16_LANE2);
        AscendC::Reg::LoadAlign(zReg3, z + BENCH_F16_LANE3);
