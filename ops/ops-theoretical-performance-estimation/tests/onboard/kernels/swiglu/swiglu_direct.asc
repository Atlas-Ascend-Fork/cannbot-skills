/**
 * swiglu 直调（<<<>>>）性能 ST —— 自包含。对应 swiglu_flow.json（elementwise）。
 *
 * out = silu(gate) * up，silu(a) = a / (1 + exp(-a))。双输入逐元素，输出同形。
 * 矢量计算用 VF（RegBase MicroAPI）；GM↔UB 同步全交 TQue。fp32（bf16 cases 理论-only）。
 * 1D：每核一段连续元素，按 tile 流水。
 */
#include <acl/acl.h>
#include "kernel_operator.h"
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <random>
#include <string>
#include <vector>

namespace {
__aicore__ inline uint32_t CeilDivK(uint32_t a, uint32_t b) { return (a + b - 1) / b; }

// VF：y = silu(gate)*up = gate/(1+exp(-gate)) * up。寄存器级。
__aicore__ inline void SwigluVF(const AscendC::LocalTensor<float>& gLocal,
                                const AscendC::LocalTensor<float>& uLocal,
                                const AscendC::LocalTensor<float>& yLocal, uint32_t count) {
    using namespace AscendC::MicroAPI;
    constexpr uint32_t VL = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    __local_mem__ float* gAddr = (__ubuf__ float*)gLocal.GetPhyAddr();
    __local_mem__ float* uAddr = (__ubuf__ float*)uLocal.GetPhyAddr();
    __local_mem__ float* yAddr = (__ubuf__ float*)yLocal.GetPhyAddr();
    uint16_t repeats = (uint16_t)CeilDivK(count, VL);
    uint32_t sreg = count;
    __VEC_SCOPE__ {
        RegTensor<float> g, u, t, s;
        MaskReg p;
        for (uint16_t i = 0; i < repeats; ++i) {
            p = UpdateMask<float>(sreg);
            DataCopy(g, gAddr + i * VL);
            DataCopy(u, uAddr + i * VL);
            Muls(t, g, -1.0f, p);          // -gate
            Exp(t, t, p);                  // exp(-gate)
            Adds(t, t, 1.0f, p);           // 1+exp(-gate)
            Div(s, g, t, p);               // silu = gate/(1+exp(-gate))
            Mul(s, s, u, p);               // * up
            DataCopy(yAddr + i * VL, s, p);
        }
    }
}
}  // namespace

__global__ __aicore__ __vector__ void swiglu_k(
    GM_ADDR gate, GM_ADDR up, GM_ADDR y, uint32_t N, uint32_t elemsPerCore, uint32_t tileElems)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> gGm, uGm, yGm;
    gGm.SetGlobalBuffer((__gm__ float*)gate);
    uGm.SetGlobalBuffer((__gm__ float*)up);
    yGm.SetGlobalBuffer((__gm__ float*)y);

    uint32_t tileBytes = tileElems * (uint32_t)sizeof(float);
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> gQ;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> uQ;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQ;
    pipe.InitBuffer(gQ, 2, tileBytes);
    pipe.InitBuffer(uQ, 2, tileBytes);
    pipe.InitBuffer(outQ, 2, tileBytes);

    AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0};
    uint32_t start = AscendC::GetBlockIdx() * elemsPerCore;
    uint32_t end = start + elemsPerCore;
    if (end > N) end = N;

    for (uint32_t off = start; off < end; off += tileElems) {
        uint32_t cur = (off + tileElems <= end) ? tileElems : (end - off);
        AscendC::DataCopyExtParams cp;
        cp.blockCount = 1; cp.blockLen = cur * (uint32_t)sizeof(float); cp.srcStride = 0; cp.dstStride = 0;

        AscendC::LocalTensor<float> gLocal = gQ.AllocTensor<float>();
        AscendC::DataCopyPad(gLocal, gGm[off], cp, pad);
        gQ.EnQue(gLocal);
        AscendC::LocalTensor<float> uLocal = uQ.AllocTensor<float>();
        AscendC::DataCopyPad(uLocal, uGm[off], cp, pad);
        uQ.EnQue(uLocal);
        gLocal = gQ.DeQue<float>();
        uLocal = uQ.DeQue<float>();

        AscendC::LocalTensor<float> yLocal = outQ.AllocTensor<float>();
        SwigluVF(gLocal, uLocal, yLocal, cur);
        outQ.EnQue(yLocal);
        gQ.FreeTensor(gLocal);
        uQ.FreeTensor(uLocal);

        yLocal = outQ.DeQue<float>();
        AscendC::DataCopyPad(yGm[off], yLocal, cp);
        outQ.FreeTensor(yLocal);
    }
}

// =============================== host ===============================
namespace {
inline uint32_t HCeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
struct Args { uint32_t n = 4194304, iters = 20, blocks = 0, tile = 8192; };
Args ParseArgs(int argc, char** argv) {
    Args a;
    for (int i = 1; i < argc; ++i) {
        std::string k = argv[i];
        auto next = [&]() -> std::string { return (i + 1 < argc) ? argv[++i] : ""; };
        if (k == "--n") a.n = (uint32_t)atoi(next().c_str());
        else if (k == "--iters") a.iters = (uint32_t)atoi(next().c_str());
        else if (k == "--blocks") a.blocks = (uint32_t)atoi(next().c_str());
        else if (k == "--tile") a.tile = (uint32_t)atoi(next().c_str());
    }
    return a;
}
}  // namespace

#define CK(call) do { aclError _e = (call); if (_e != ACL_SUCCESS) { printf("ACL FAIL %s:%d ret=%d\n", __FILE__, __LINE__, (int)_e); return 1; } } while (0)

int main(int argc, char** argv) {
    Args a = ParseArgs(argc, argv);
    uint32_t N = a.n;
    uint32_t blocks = a.blocks ? a.blocks : (N < 64 ? N : 64);
    uint32_t elemsPerCore = HCeilDiv(N, blocks);

    std::vector<float> hG(N), hU(N), hY(N), gold(N);
    std::mt19937 gen(12345);
    std::uniform_real_distribution<float> dist(-3.0f, 3.0f);
    for (auto& v : hG) v = dist(gen);
    for (auto& v : hU) v = dist(gen);
    for (uint32_t i = 0; i < N; ++i) {
        float g = hG[i];
        float silu = g / (1.0f + std::exp(-g));
        gold[i] = silu * hU[i];
    }

    CK(aclInit(nullptr));
    CK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CK(aclrtCreateStream(&stream));

    void* dG = nullptr; void* dU = nullptr; void* dY = nullptr;
    CK(aclrtMalloc(&dG, (size_t)N * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc(&dU, (size_t)N * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc(&dY, (size_t)N * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMemcpy(dG, (size_t)N * sizeof(float), hG.data(), (size_t)N * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));
    CK(aclrtMemcpy(dU, (size_t)N * sizeof(float), hU.data(), (size_t)N * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));

    auto launch = [&]() {
        swiglu_k<<<blocks, nullptr, stream>>>((GM_ADDR)dG, (GM_ADDR)dU, (GM_ADDR)dY, N, elemsPerCore, a.tile);
    };
    launch();
    CK(aclrtSynchronizeStream(stream));

    aclrtEvent evStart = nullptr, evStop = nullptr;
    CK(aclrtCreateEvent(&evStart));
    CK(aclrtCreateEvent(&evStop));
    CK(aclrtRecordEvent(evStart, stream));
    for (uint32_t i = 0; i < a.iters; ++i) launch();
    CK(aclrtRecordEvent(evStop, stream));
    CK(aclrtSynchronizeStream(stream));
    float ms = 0.0f;
    CK(aclrtEventElapsedTime(&ms, evStart, evStop));
    double usPerIter = (double)ms * 1000.0 / a.iters;

    CK(aclrtMemcpy(hY.data(), (size_t)N * sizeof(float), dY, (size_t)N * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST));
    double maxRel = 0.0;
    for (uint32_t i = 0; i < N; ++i) {
        float d = std::fabs(hY[i] - gold[i]);
        float den = std::fabs(gold[i]) + 1e-4f;
        double rel = d / den;
        if (rel > maxRel) maxRel = rel;
    }
    bool ok = maxRel < 5e-3;
    printf("RESULT op=swiglu n=%u blocks=%u tile=%u iters=%u us=%.3f golden=%s maxRel=%.2e\n",
           N, blocks, a.tile, a.iters, usPerIter, ok ? "PASS" : "FAIL", maxRel);

    aclrtDestroyEvent(evStart); aclrtDestroyEvent(evStop);
    aclrtFree(dG); aclrtFree(dU); aclrtFree(dY);
    aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();
    return ok ? 0 : 2;
}
