/**
 * membw 直调(<<<>>>) —— GM 带宽标定仪器(纯访存，零有效计算)。
 *
 * MODE(编译期)：0=read(只读，reduce 防 DCE) / 1=write(只写常量) / 2=copy(读+写)。
 * 同一 kernel，按 buffer 大小区分区间：大 buffer(≥512MB,远超 L2)→HBM 持续带宽；
 * 小 buffer(≤32MB,驻 L2)→L2 带宽。iters 循环复用同一 buffer：大尺寸 cache 命不中→真 HBM，
 * 小尺寸→L2 命中。fp32。用于标定 ascend950pr.json 的 hbm_sustained / l2_bandwidth / l2_aware 曲线。
 */
#include <acl/acl.h>
#include "kernel_operator.h"
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <string>
#include <vector>

namespace {
__aicore__ inline uint32_t CeilDivK(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
__aicore__ inline uint32_t TileBytes(uint32_t elems) {
    constexpr uint32_t VL = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    return CeilDivK(elems, VL) * VL * (uint32_t)sizeof(float);
}
}  // namespace

// MODE: 0=read 1=write 2=copy。digest 仅 read 用(写每核一个标量，防止读被 DCE)。
template <uint32_t MODE>
__global__ __aicore__ __vector__ void membw_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR digest, uint32_t N, uint32_t elemsPerCore, uint32_t tileElems)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> xGm, yGm, dGm;
    xGm.SetGlobalBuffer((__gm__ float*)x);
    yGm.SetGlobalBuffer((__gm__ float*)y);
    dGm.SetGlobalBuffer((__gm__ float*)digest);
    uint32_t tileBytes = TileBytes(tileElems);
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQ;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> accBuf;
    if constexpr (MODE != 1) pipe.InitBuffer(inQ, 2, tileBytes);
    if constexpr (MODE != 0) pipe.InitBuffer(outQ, 2, tileBytes);
    if constexpr (MODE == 0) pipe.InitBuffer(accBuf, 32);
    AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0};

    uint32_t start = AscendC::GetBlockIdx() * elemsPerCore;
    uint32_t end = start + elemsPerCore;
    if (end > N) end = N;

    AscendC::LocalTensor<float> acc;
    if constexpr (MODE == 0) { acc = accBuf.Get<float>(); }

    for (uint32_t off = start; off < end; off += tileElems) {
        uint32_t cur = (off + tileElems <= end) ? tileElems : (end - off);
        AscendC::DataCopyExtParams cp;
        cp.blockCount = 1; cp.blockLen = cur * (uint32_t)sizeof(float); cp.srcStride = 0; cp.dstStride = 0;
        if constexpr (MODE == 0) {            // read：load + 累加(防 DCE)
            AscendC::LocalTensor<float> xLocal = inQ.AllocTensor<float>();
            AscendC::DataCopyPad(xLocal, xGm[off], cp, pad);
            inQ.EnQue(xLocal); xLocal = inQ.DeQue<float>();
            AscendC::Add(acc, acc, xLocal, 8);   // 取前 8 元素累加，极轻、被读隐藏
            inQ.FreeTensor(xLocal);
        } else if constexpr (MODE == 1) {     // write：常量写出
            AscendC::LocalTensor<float> yLocal = outQ.AllocTensor<float>();
            AscendC::Duplicate(yLocal, 1.0f, (int32_t)cur);
            outQ.EnQue(yLocal); yLocal = outQ.DeQue<float>();
            AscendC::DataCopyPad(yGm[off], yLocal, cp);
            outQ.FreeTensor(yLocal);
        } else {                              // copy：读 + 写
            AscendC::LocalTensor<float> xLocal = inQ.AllocTensor<float>();
            AscendC::DataCopyPad(xLocal, xGm[off], cp, pad);
            inQ.EnQue(xLocal); xLocal = inQ.DeQue<float>();
            AscendC::DataCopyPad(yGm[off], xLocal, cp);
            inQ.FreeTensor(xLocal);
        }
    }
    if constexpr (MODE == 0) {                // 把累加写出去，确保读不被优化掉
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopyExtParams dp; dp.blockCount = 1; dp.blockLen = sizeof(float); dp.srcStride = 0; dp.dstStride = 0;
        AscendC::DataCopyPad(dGm[AscendC::GetBlockIdx()], acc, dp);
    }
}

// =============================== host ===============================
namespace {
inline uint32_t HCeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
struct Args { uint32_t mb = 512, iters = 30, blocks = 0, tile = 16384; std::string mode = "copy"; };
Args ParseArgs(int argc, char** argv) {
    Args a;
    for (int i = 1; i < argc; ++i) {
        std::string k = argv[i];
        auto nx = [&]() -> std::string { return (i + 1 < argc) ? argv[++i] : ""; };
        if (k == "--mb") a.mb = (uint32_t)atoi(nx().c_str());
        else if (k == "--iters") a.iters = (uint32_t)atoi(nx().c_str());
        else if (k == "--blocks") a.blocks = (uint32_t)atoi(nx().c_str());
        else if (k == "--tile") a.tile = (uint32_t)atoi(nx().c_str());
        else if (k == "--mode") a.mode = nx();
    }
    return a;
}
}  // namespace

#define CK(call) do { aclError _e=(call); if(_e!=ACL_SUCCESS){printf("ACL FAIL %s:%d ret=%d\n",__FILE__,__LINE__,(int)_e);return 1;} } while(0)

int main(int argc, char** argv) {
    Args a = ParseArgs(argc, argv);
    int mode = a.mode == "read" ? 0 : a.mode == "write" ? 1 : 2;
    uint32_t N = (uint32_t)((size_t)a.mb * 1024 * 1024 / sizeof(float));
    uint32_t blocks = a.blocks ? a.blocks : 64;
    uint32_t elemsPerCore = HCeilDiv(N, blocks);

    CK(aclInit(nullptr)); CK(aclrtSetDevice(0));
    aclrtStream stream = nullptr; CK(aclrtCreateStream(&stream));
    void *dX = nullptr, *dY = nullptr, *dDig = nullptr;
    size_t bytes = (size_t)N * sizeof(float);
    CK(aclrtMalloc(&dX, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc(&dY, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc(&dDig, (size_t)blocks * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    { std::vector<float> h(N, 1.0f); CK(aclrtMemcpy(dX, bytes, h.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE)); }

    auto launch = [&]() {
        if (mode == 0) membw_kernel<0><<<blocks, nullptr, stream>>>((GM_ADDR)dX,(GM_ADDR)dY,(GM_ADDR)dDig,N,elemsPerCore,a.tile);
        else if (mode == 1) membw_kernel<1><<<blocks, nullptr, stream>>>((GM_ADDR)dX,(GM_ADDR)dY,(GM_ADDR)dDig,N,elemsPerCore,a.tile);
        else membw_kernel<2><<<blocks, nullptr, stream>>>((GM_ADDR)dX,(GM_ADDR)dY,(GM_ADDR)dDig,N,elemsPerCore,a.tile);
    };
    launch(); CK(aclrtSynchronizeStream(stream));
    aclrtEvent e0=nullptr,e1=nullptr; CK(aclrtCreateEvent(&e0)); CK(aclrtCreateEvent(&e1));
    CK(aclrtRecordEvent(e0, stream));
    for (uint32_t i = 0; i < a.iters; ++i) launch();
    CK(aclrtRecordEvent(e1, stream)); CK(aclrtSynchronizeStream(stream));
    float ms = 0.0f; CK(aclrtEventElapsedTime(&ms, e0, e1));
    double us = (double)ms * 1000.0 / a.iters;
    // 流量：read=N读, write=N写, copy=N读+N写
    double moved_MB = (double)a.mb * (mode == 2 ? 2.0 : 1.0);
    double bw = moved_MB / 1024.0 / 1024.0 / (us * 1e-6) / 1e12 * 1024 * 1024; // TB/s
    bw = (moved_MB * 1024.0 * 1024.0) / (us * 1e-6) / 1e12;
    printf("RESULT op=membw mode=%s mb=%u iters=%u blocks=%u us=%.3f bw_TBps=%.3f\n",
           a.mode.c_str(), a.mb, a.iters, blocks, us, bw);
    aclrtDestroyEvent(e0); aclrtDestroyEvent(e1);
    aclrtFree(dX); aclrtFree(dY); aclrtFree(dDig);
    aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();
    return 0;
}
