/**
 * vchain 直调(<<<>>>) —— 合成的 vector-bound 算子(bf16 输入)，验证引擎 roofline 的
 * **vector 半边**(issue/cycle、超越函数 transcendental 子管线、低精度 Cast)端到端对照实测。
 *
 * 每元素 y = Σ_{k=0}^{K-1} sqrt(x+k)：K 个 sqrt **各自独立**(参数互不依赖)→**吞吐受限**(非依赖链)，
 * 这样理论(Sqrt 吞吐地板)≈实测，可真正验证 vector 模型。4 路 k 交织 + 4 累加器填满 sqrt 流水。
 * bf16 I/O + fp32 计算(读后 Cast bf16→fp32、写前 Cast fp32→bf16)：访存减半→更 vector-bound。
 * K 大 → vector_time ≫ mte ≫ launch_floor。与 vchain_flow.json 逐 op 对齐(Cast + Adds×K + Sqrt×K +
 * Add×K + Cast)。矢量计算用 VF(__VEC_SCOPE__/MicroAPI)，GM↔UB 同步全交 TQue。
 */
#include <acl/acl.h>
#include "kernel_operator.h"
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <random>
#include <string>
#include <vector>

namespace {
constexpr uint32_t MWAY = 4;     // 交织路数：sqrt 依赖链靠 MWAY 路独立链掩盖延迟→吞吐受限(4 路即饱和)
__aicore__ inline uint32_t CeilDivK(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
__aicore__ inline uint32_t TileBytesB16(uint32_t elems) {
    constexpr uint32_t VL = AscendC::VECTOR_REG_WIDTH / sizeof(float);   // 每步处理的 bf16 元素数(unpack 到 fp32 reg)
    return CeilDivK(elems, MWAY * VL) * (MWAY * VL) * (uint32_t)sizeof(bfloat16_t);
}

// bf16<->fp32 cast trait（值取自 toolkit op_common/op_kernel/load_store_utils.h）。必须命名空间作用域
// (Cast 的 trait 是模板引用参，需静态存储)，且只在 device 遍可见(__NPU_ARCH__ 仅 device 定义；
// 命名空间作用域引用 MicroAPI 在 .asc 的 host 遍不可见)。
#if defined(__NPU_ARCH__)
constexpr AscendC::MicroAPI::CastTrait CT_B16_TO_F32 = {
    AscendC::MicroAPI::RegLayout::ZERO, AscendC::MicroAPI::SatMode::UNKNOWN,
    AscendC::MicroAPI::MaskMergeMode::ZEROING, AscendC::RoundMode::UNKNOWN};
constexpr AscendC::MicroAPI::CastTrait CT_F32_TO_B16 = {
    AscendC::MicroAPI::RegLayout::ZERO, AscendC::MicroAPI::SatMode::NO_SAT,
    AscendC::MicroAPI::MaskMergeMode::ZEROING, AscendC::RoundMode::CAST_RINT};
#endif

// VF：bf16 in → fp32 → y = Σ_{k=0}^{K-1} sqrt(x+k) → bf16 out。
// **吞吐最优**：K 个 sqrt 各自独立(参数 x+k 互不依赖)，4 路 k 交织 + 4 累加器 → 填满 sqrt 流水、
// 受吞吐限(非延迟链)。这样理论(吞吐地板)≈实测，可真正验证 vector 模型。每元素逐 VL-chunk 处理，
// chunk 间也独立、跨 chunk 再流水。K 假定为 4 的倍数(用例 64/128)。
__aicore__ inline void ChainVF(const AscendC::LocalTensor<bfloat16_t>& xLocal,
                               const AscendC::LocalTensor<bfloat16_t>& yLocal, uint32_t count, uint32_t K) {
#if defined(__NPU_ARCH__)
    using namespace AscendC::MicroAPI;
    constexpr uint32_t VL = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    __local_mem__ bfloat16_t* xAddr = (__ubuf__ bfloat16_t*)xLocal.GetPhyAddr();
    __local_mem__ bfloat16_t* yAddr = (__ubuf__ bfloat16_t*)yLocal.GetPhyAddr();
    uint16_t repeats = (uint16_t)CeilDivK(count, VL);
    uint32_t sreg = count;
    __VEC_SCOPE__ {
        RegTensor<bfloat16_t> bx, by;
        RegTensor<float> x, a0, a1, a2, a3, k0, k1, k2, k3, s0, s1, s2, s3;
        MaskReg pf = CreateMask<float, MaskPattern::ALL>();
        MaskReg p;
        for (uint16_t i = 0; i < repeats; ++i) {
            p = UpdateMask<float>(sreg);
            DataCopy<bfloat16_t, LoadDist::DIST_UNPACK_B16>(bx, xAddr + (uint32_t)i * VL);
            Cast<float, bfloat16_t, CT_B16_TO_F32>(x, bx, p);
            Duplicate(a0, 0.0f, pf); Duplicate(a1, 0.0f, pf); Duplicate(a2, 0.0f, pf); Duplicate(a3, 0.0f, pf);
            Adds(k0, x, 0.0f, p); Adds(k1, x, 1.0f, p); Adds(k2, x, 2.0f, p); Adds(k3, x, 3.0f, p);  // x+{0,1,2,3}
            for (uint16_t k = 0; k < (uint16_t)K; k += 4) {        // 4 路独立 sqrt(x+k)，4 累加器；步进常量 4
                Sqrt(s0, k0, p); Sqrt(s1, k1, p); Sqrt(s2, k2, p); Sqrt(s3, k3, p);
                Add(a0, a0, s0, p); Add(a1, a1, s1, p); Add(a2, a2, s2, p); Add(a3, a3, s3, p);
                Adds(k0, k0, 4.0f, p); Adds(k1, k1, 4.0f, p); Adds(k2, k2, 4.0f, p); Adds(k3, k3, 4.0f, p);
            }
            Add(a0, a0, a1, p); Add(a2, a2, a3, p); Add(a0, a0, a2, p);
            Cast<bfloat16_t, float, CT_F32_TO_B16>(by, a0, p);
            DataCopy<bfloat16_t, StoreDist::DIST_PACK_B32>(yAddr + (uint32_t)i * VL, by, p);
        }
    }
#endif
}
}  // namespace

// 1D elementwise(bf16)：每核一段连续元素，按 tile 流水。
__global__ __aicore__ __vector__ void vchain_kernel(
    GM_ADDR x, GM_ADDR y, uint32_t N, uint32_t elemsPerCore, uint32_t tileElems, uint32_t K)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<bfloat16_t> xGm, yGm;
    xGm.SetGlobalBuffer((__gm__ bfloat16_t*)x);
    yGm.SetGlobalBuffer((__gm__ bfloat16_t*)y);
    uint32_t tileBytes = TileBytesB16(tileElems);
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQ;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQ;
    pipe.InitBuffer(inQ, 2, tileBytes);
    pipe.InitBuffer(outQ, 2, tileBytes);
    AscendC::DataCopyPadExtParams<bfloat16_t> pad{false, 0, 0, 0};

    uint32_t start = AscendC::GetBlockIdx() * elemsPerCore;
    uint32_t end = start + elemsPerCore;
    if (end > N) end = N;
    for (uint32_t off = start; off < end; off += tileElems) {
        uint32_t cur = (off + tileElems <= end) ? tileElems : (end - off);
        AscendC::DataCopyExtParams cp;
        cp.blockCount = 1; cp.blockLen = cur * (uint32_t)sizeof(bfloat16_t); cp.srcStride = 0; cp.dstStride = 0;
        AscendC::LocalTensor<bfloat16_t> xLocal = inQ.AllocTensor<bfloat16_t>();
        AscendC::DataCopyPad(xLocal, xGm[off], cp, pad);
        inQ.EnQue(xLocal);
        xLocal = inQ.DeQue<bfloat16_t>();
        AscendC::LocalTensor<bfloat16_t> yLocal = outQ.AllocTensor<bfloat16_t>();
        ChainVF(xLocal, yLocal, cur, K);
        outQ.EnQue(yLocal);
        inQ.FreeTensor(xLocal);
        yLocal = outQ.DeQue<bfloat16_t>();
        AscendC::DataCopyPad(yGm[off], yLocal, cp);
        outQ.FreeTensor(yLocal);
    }
}

// =============================== host ===============================
namespace {
inline uint32_t HCeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }

// fp32 <-> bf16(uint16 存储)：bf16 = fp32 高 16 位，round-to-nearest-even。
inline uint16_t F2BF16(float f) {
    uint32_t bits;
    std::memcpy(&bits, &f, sizeof(bits));
    uint32_t lsb = (bits >> 16) & 1u;
    bits += 0x7FFFu + lsb;
    return (uint16_t)(bits >> 16);
}
inline float BF162F(uint16_t h) {
    uint32_t bits = (uint32_t)h << 16;
    float f;
    std::memcpy(&f, &bits, sizeof(f));
    return f;
}

struct Args {
    uint32_t rows = 4096, cols = 2048, iters = 20, blocks = 0, tile = 8192, K = 64;
};
Args ParseArgs(int argc, char** argv) {
    Args a;
    for (int i = 1; i < argc; ++i) {
        std::string k = argv[i];
        auto next = [&]() -> std::string { return (i + 1 < argc) ? argv[++i] : ""; };
        if (k == "--rows") a.rows = (uint32_t)atoi(next().c_str());
        else if (k == "--cols") a.cols = (uint32_t)atoi(next().c_str());
        else if (k == "--iters") a.iters = (uint32_t)atoi(next().c_str());
        else if (k == "--blocks") a.blocks = (uint32_t)atoi(next().c_str());
        else if (k == "--tile") a.tile = (uint32_t)atoi(next().c_str());
        else if (k == "--K") a.K = (uint32_t)atoi(next().c_str());
    }
    return a;
}
}  // namespace

#define CK(call)                                                                                   \
    do {                                                                                           \
        aclError _e = (call);                                                                      \
        if (_e != ACL_SUCCESS) { printf("ACL FAIL %s:%d ret=%d\n", __FILE__, __LINE__, (int)_e); return 1; } \
    } while (0)

int main(int argc, char** argv) {
    Args a = ParseArgs(argc, argv);
    uint32_t N = a.rows * a.cols;
    uint32_t blocks = a.blocks ? a.blocks : (N < 64 ? N : 64);
    uint32_t elemsPerCore = HCeilDiv(N, blocks);

    std::vector<uint16_t> hX(N), hY(N), gold(N);   // bf16 存为 uint16
    std::mt19937 gen(12345);
    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
    for (uint32_t i = 0; i < N; ++i) hX[i] = F2BF16(dist(gen));
    for (uint32_t i = 0; i < N; ++i) {             // golden：y = Σ_{k} sqrt(x+k)（独立累加，与 kernel 同）
        float x = BF162F(hX[i]), acc = 0.0f;
        for (uint32_t k = 0; k < a.K; ++k) acc += std::sqrt(x + (float)k);
        gold[i] = F2BF16(acc);
    }

    CK(aclInit(nullptr));
    CK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CK(aclrtCreateStream(&stream));
    void* dX = nullptr;
    void* dY = nullptr;
    size_t bytes = (size_t)N * sizeof(uint16_t);
    CK(aclrtMalloc(&dX, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc(&dY, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMemcpy(dX, bytes, hX.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));

    auto launch = [&]() {
        vchain_kernel<<<blocks, nullptr, stream>>>((GM_ADDR)dX, (GM_ADDR)dY, N, elemsPerCore, a.tile, a.K);
    };
    launch();
    CK(aclrtSynchronizeStream(stream));
    aclrtEvent evStart = nullptr, evStop = nullptr;
    CK(aclrtCreateEvent(&evStart));
    CK(aclrtCreateEvent(&evStop));
    CK(aclrtRecordEvent(evStart, stream));
    for (uint32_t i = 0; i < a.iters; ++i) launch();
    CK(aclrtRecordEvent(evStop, stream));
    CK(aclrtSynchronizeStream(stream));
    float ms = 0.0f;
    CK(aclrtEventElapsedTime(&ms, evStart, evStop));
    double usPerIter = (double)ms * 1000.0 / a.iters;
    CK(aclrtMemcpy(hY.data(), bytes, dY, bytes, ACL_MEMCPY_DEVICE_TO_HOST));

    double maxRel = 0.0;
    for (uint32_t i = 0; i < N; ++i) {
        float dv = BF162F(hY[i]), gv = BF162F(gold[i]);
        double rel = std::fabs(dv - gv) / (std::fabs(gv) + 1e-6f);
        if (rel > maxRel) maxRel = rel;
    }
    bool ok = maxRel < 2e-2;     // bf16 ~0.4% 精度，容差放宽
    printf("RESULT op=vchain dtype=bf16 rows=%u cols=%u N=%u blocks=%u tile=%u K=%u iters=%u "
           "us=%.3f golden=%s maxRel=%.2e\n",
           a.rows, a.cols, N, blocks, a.tile, a.K, a.iters, usPerIter, ok ? "PASS" : "FAIL", maxRel);

    aclrtDestroyEvent(evStart);
    aclrtDestroyEvent(evStop);
    aclrtFree(dX); aclrtFree(dY);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return ok ? 0 : 2;
}
