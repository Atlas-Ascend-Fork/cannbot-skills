/**
 * rms_norm 直调（<<<>>>）性能 ST —— 自包含，不挂算子框架。
 *
 * 矢量计算用 VF（RegBase MicroAPI，__VEC_SCOPE__ 寄存器级），照 ops-nn/norm/rms_norm
 * 的 arch35 RegBase（ComputeFormerImplV1 / ComputeRstd / ComputeY）的 idiom 写；
 * GM↔UB 同步**全部交给 TQue EnQue/DeQue**，不手插 SetFlag/WaitFlag；
 * rstd 留在 UB，y 计算时用 DIST_BRC_B32 广播加载进寄存器（不做 V→S 标量回读）。
 *
 * 两套 kernel ↔ rms_norm_flow.json 两个模版：
 *   - rms_norm_full  : row_resident_1pass —— 整行常驻 UB，x 从 GM 读 **一次**
 *   - rms_norm_split : row_split_2pass    —— H 大放不下 UB，按列切 chunk，x 从 GM 读 **两次**
 * 每行两段 VF：VF1 = Σx² → rstd ；VF2 = y = x·rstd·gamma （fp32）。
 */
#include <acl/acl.h>
#include "kernel_operator.h"
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <random>
#include <string>
#include <vector>

namespace {
constexpr uint32_t NACC = 4;     // reduce 多累加器路数：打断 Add 依赖链，提 ILP
// VECTOR_REG_WIDTH / MicroAPI 仅在 device 上下文声明，故 VL 与 using 都放进函数体内（.asc 走 host+device 两遍编译）。
__aicore__ inline uint32_t CeilDivK(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
__aicore__ inline uint32_t RowBytes(uint32_t elems) {                // 对齐到 NACC*VL：4 路展开的尾组满载加载不越界
    constexpr uint32_t VL = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    return CeilDivK(elems, NACC * VL) * (NACC * VL) * (uint32_t)sizeof(float);
}

// VF1：xRow[count] → rstdLocal[slot]  （Σx²·avgFactor + eps → 1/sqrt）。寄存器级，无 GM。
__aicore__ inline void RstdVF(const AscendC::LocalTensor<float>& xLocal,
                              const AscendC::LocalTensor<float>& rstdLocal,
                              uint32_t slot, uint32_t count, float avgFactor, float eps) {
    using namespace AscendC::MicroAPI;
    constexpr uint32_t VL = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    __local_mem__ float* xAddr = (__ubuf__ float*)xLocal.GetPhyAddr();
    __local_mem__ float* rstdAddr = (__ubuf__ float*)rstdLocal.GetPhyAddr() + slot;
    uint16_t groups = (uint16_t)CeilDivK(count, NACC * VL);
    uint32_t sreg = count;
    __VEC_SCOPE__ {
        RegTensor<float> x0, x1, x2, x3, acc0, acc1, acc2, acc3, vMean, oneReg, rstdReg;
        MaskReg pregFull = CreateMask<float, MaskPattern::ALL>();
        MaskReg pregMerge = CreateMask<float, MaskPattern::VL1>();
        MaskReg p0, p1, p2, p3;
        Duplicate(acc0, 0.0f, pregFull); Duplicate(acc1, 0.0f, pregFull);
        Duplicate(acc2, 0.0f, pregFull); Duplicate(acc3, 0.0f, pregFull);
        for (uint16_t g = 0; g < groups; ++g) {       // 4 路独立累加链（尾组 sreg=0 时 mask 空，DataCopy 落对齐填充区不越界）
            uint32_t base = (uint32_t)g * NACC;
            p0 = UpdateMask<float>(sreg); DataCopy(x0, xAddr + (base + 0) * VL); Mul(x0, x0, x0, p0); Add(acc0, acc0, x0, p0);
            p1 = UpdateMask<float>(sreg); DataCopy(x1, xAddr + (base + 1) * VL); Mul(x1, x1, x1, p1); Add(acc1, acc1, x1, p1);
            p2 = UpdateMask<float>(sreg); DataCopy(x2, xAddr + (base + 2) * VL); Mul(x2, x2, x2, p2); Add(acc2, acc2, x2, p2);
            p3 = UpdateMask<float>(sreg); DataCopy(x3, xAddr + (base + 3) * VL); Mul(x3, x3, x3, p3); Add(acc3, acc3, x3, p3);
        }
        Add(acc0, acc0, acc1, pregFull); Add(acc2, acc2, acc3, pregFull); Add(acc0, acc0, acc2, pregFull);
        ReduceSum(vMean, acc0, pregFull);             // 横向归约 → lane0 = Σx²
        Muls(vMean, vMean, avgFactor, pregMerge);     // /H
        Adds(vMean, vMean, eps, pregMerge);
        Sqrt(vMean, vMean, pregMerge);
        Duplicate(oneReg, 1.0f, pregMerge);
        Div(rstdReg, oneReg, vMean, pregMerge);       // 1/sqrt
        DataCopy<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rstdAddr, rstdReg, pregMerge);
    }
}

// 把每 chunk 的 Σx² 偏导存到 workLocal[c]（非全载 pass1 用）
__aicore__ inline void ChunkSumsqVF(const AscendC::LocalTensor<float>& xLocal,
                                    const AscendC::LocalTensor<float>& workLocal,
                                    uint32_t c, uint32_t len) {
    using namespace AscendC::MicroAPI;
    constexpr uint32_t VL = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    __local_mem__ float* xAddr = (__ubuf__ float*)xLocal.GetPhyAddr();
    __local_mem__ float* workAddr = (__ubuf__ float*)workLocal.GetPhyAddr();
    uint16_t groups = (uint16_t)CeilDivK(len, NACC * VL);
    uint32_t sreg = len;
    __VEC_SCOPE__ {
        RegTensor<float> x0, x1, x2, x3, acc0, acc1, acc2, acc3, vMean;
        MaskReg pregFull = CreateMask<float, MaskPattern::ALL>();
        MaskReg pregMerge = CreateMask<float, MaskPattern::VL1>();
        MaskReg p0, p1, p2, p3;
        Duplicate(acc0, 0.0f, pregFull); Duplicate(acc1, 0.0f, pregFull);
        Duplicate(acc2, 0.0f, pregFull); Duplicate(acc3, 0.0f, pregFull);
        for (uint16_t g = 0; g < groups; ++g) {
            uint32_t base = (uint32_t)g * NACC;
            p0 = UpdateMask<float>(sreg); DataCopy(x0, xAddr + (base + 0) * VL); Mul(x0, x0, x0, p0); Add(acc0, acc0, x0, p0);
            p1 = UpdateMask<float>(sreg); DataCopy(x1, xAddr + (base + 1) * VL); Mul(x1, x1, x1, p1); Add(acc1, acc1, x1, p1);
            p2 = UpdateMask<float>(sreg); DataCopy(x2, xAddr + (base + 2) * VL); Mul(x2, x2, x2, p2); Add(acc2, acc2, x2, p2);
            p3 = UpdateMask<float>(sreg); DataCopy(x3, xAddr + (base + 3) * VL); Mul(x3, x3, x3, p3); Add(acc3, acc3, x3, p3);
        }
        Add(acc0, acc0, acc1, pregFull); Add(acc2, acc2, acc3, pregFull); Add(acc0, acc0, acc2, pregFull);
        ReduceSum(vMean, acc0, pregFull);
        DataCopy<float, StoreDist::DIST_FIRST_ELEMENT_B32>(workAddr + c, vMean, pregMerge);
    }
}

// 把 workLocal[0..nChunk-1] 求和 → rstdLocal[0]（非全载 pass1 收尾）
__aicore__ inline void WorkToRstdVF(const AscendC::LocalTensor<float>& workLocal,
                                    const AscendC::LocalTensor<float>& rstdLocal,
                                    uint32_t nChunk, float avgFactor, float eps) {
    using namespace AscendC::MicroAPI;
    __local_mem__ float* workAddr = (__ubuf__ float*)workLocal.GetPhyAddr();
    __local_mem__ float* rstdAddr = (__ubuf__ float*)rstdLocal.GetPhyAddr();
    uint32_t sreg = nChunk;
    __VEC_SCOPE__ {
        RegTensor<float> wReg, vTotal, oneReg, rstdReg;
        MaskReg pregMerge = CreateMask<float, MaskPattern::VL1>();
        MaskReg pregN = UpdateMask<float>(sreg);
        DataCopy(wReg, workAddr);
        ReduceSum(vTotal, wReg, pregN);
        Muls(vTotal, vTotal, avgFactor, pregMerge);
        Adds(vTotal, vTotal, eps, pregMerge);
        Sqrt(vTotal, vTotal, pregMerge);
        Duplicate(oneReg, 1.0f, pregMerge);
        Div(rstdReg, oneReg, vTotal, pregMerge);
        DataCopy<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rstdAddr, rstdReg, pregMerge);
    }
}

// VF2：yLocal = xLocal · rstd · gammaLocal（rstd 广播加载）
__aicore__ inline void NormVF(const AscendC::LocalTensor<float>& xLocal,
                              const AscendC::LocalTensor<float>& gammaLocal,
                              const AscendC::LocalTensor<float>& rstdLocal, uint32_t slot,
                              const AscendC::LocalTensor<float>& yLocal, uint32_t count) {
    using namespace AscendC::MicroAPI;
    constexpr uint32_t VL = AscendC::VECTOR_REG_WIDTH / sizeof(float);
    __local_mem__ float* xAddr = (__ubuf__ float*)xLocal.GetPhyAddr();
    __local_mem__ float* gAddr = (__ubuf__ float*)gammaLocal.GetPhyAddr();
    __local_mem__ float* rstdAddr = (__ubuf__ float*)rstdLocal.GetPhyAddr() + slot;
    __local_mem__ float* yAddr = (__ubuf__ float*)yLocal.GetPhyAddr();
    uint16_t repeats = (uint16_t)CeilDivK(count, VL);
    uint32_t sreg = count;
    __VEC_SCOPE__ {
        RegTensor<float> xReg, gReg, tReg, yReg, rstdBrc;
        MaskReg pregLoop;
        DataCopy<float, LoadDist::DIST_BRC_B32>(rstdBrc, rstdAddr);   // lane0 广播到所有通道
        for (uint16_t i = 0; i < repeats; ++i) {
            pregLoop = UpdateMask<float>(sreg);
            DataCopy(xReg, xAddr + i * VL);
            DataCopy(gReg, gAddr + i * VL);
            Mul(tReg, xReg, rstdBrc, pregLoop);
            Mul(yReg, tReg, gReg, pregLoop);
            DataCopy(yAddr + i * VL, yReg, pregLoop);
        }
    }
}
}  // namespace

// ------------------------- kernel: 全载（x 读一次） -------------------------
__global__ __aicore__ __vector__ void rms_norm_full(
    GM_ADDR x, GM_ADDR gamma, GM_ADDR y, uint32_t R, uint32_t H, float eps,
    uint32_t rowsPerCore, uint32_t rowFactor)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> xGm, gammaGm, yGm;
    xGm.SetGlobalBuffer((__gm__ float*)x);
    gammaGm.SetGlobalBuffer((__gm__ float*)gamma);
    yGm.SetGlobalBuffer((__gm__ float*)y);

    // MultiN：一个 tile 载入 rowFactor 行（连续），多行独立 reduce/normalize；tile 双缓冲。
    uint32_t rowBytes = RowBytes(H);
    uint32_t tileBytes = rowFactor * rowBytes;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQ;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> gammaQ;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rstdBuf;
    pipe.InitBuffer(inQ, 2, tileBytes);
    pipe.InitBuffer(gammaQ, 1, rowBytes);
    pipe.InitBuffer(outQ, 2, tileBytes);
    pipe.InitBuffer(rstdBuf, 256);                  // 至多 rowFactor 个 rstd 标量

    AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0};
    float avgFactor = 1.0f / (float)H;

    AscendC::DataCopyExtParams gcp;
    gcp.blockCount = 1; gcp.blockLen = H * (uint32_t)sizeof(float); gcp.srcStride = 0; gcp.dstStride = 0;
    AscendC::LocalTensor<float> gammaLocal = gammaQ.AllocTensor<float>();   // gamma 常驻，一次载入
    AscendC::DataCopyPad(gammaLocal, gammaGm, gcp, pad);
    gammaQ.EnQue(gammaLocal);
    gammaLocal = gammaQ.DeQue<float>();

    AscendC::LocalTensor<float> rstd = rstdBuf.Get<float>();
    uint32_t start = AscendC::GetBlockIdx() * rowsPerCore;
    uint32_t end = start + rowsPerCore;
    if (end > R) end = R;

    for (uint32_t r = start; r < end; r += rowFactor) {
        uint32_t curRows = (r + rowFactor <= end) ? rowFactor : (end - r);
        uint32_t tileElems = curRows * H;
        AscendC::DataCopyExtParams cp;
        cp.blockCount = 1; cp.blockLen = tileElems * (uint32_t)sizeof(float); cp.srcStride = 0; cp.dstStride = 0;

        AscendC::LocalTensor<float> xLocal = inQ.AllocTensor<float>();
        AscendC::DataCopyPad(xLocal, xGm[(uint64_t)r * H], cp, pad);   // copy_in 整个 tile（rowFactor 行，一次大 DMA）
        inQ.EnQue(xLocal);
        xLocal = inQ.DeQue<float>();

        for (uint32_t j = 0; j < curRows; ++j)
            RstdVF(xLocal[j * H], rstd, j, H, avgFactor, eps);          // VF1 ×curRows（独立，互相重叠）
        AscendC::LocalTensor<float> yLocal = outQ.AllocTensor<float>();
        for (uint32_t j = 0; j < curRows; ++j)
            NormVF(xLocal[j * H], gammaLocal, rstd, j, yLocal[j * H], H); // VF2 ×curRows
        outQ.EnQue(yLocal);
        inQ.FreeTensor(xLocal);

        yLocal = outQ.DeQue<float>();
        AscendC::DataCopyPad(yGm[(uint64_t)r * H], yLocal, cp);         // copy_out 整个 tile
        outQ.FreeTensor(yLocal);
    }
    gammaQ.FreeTensor(gammaLocal);
}

// ------------------------- kernel: 非全载切 D（x 读两次） -------------------------
__global__ __aicore__ __vector__ void rms_norm_split(
    GM_ADDR x, GM_ADDR gamma, GM_ADDR y, uint32_t R, uint32_t H, float eps,
    uint32_t rowsPerCore, uint32_t chunk)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> xGm, gammaGm, yGm;
    xGm.SetGlobalBuffer((__gm__ float*)x);
    gammaGm.SetGlobalBuffer((__gm__ float*)gamma);
    yGm.SetGlobalBuffer((__gm__ float*)y);

    uint32_t chunkBytes = RowBytes(chunk);
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQ;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> gQ;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rstdBuf, workBuf;
    pipe.InitBuffer(inQ, 2, chunkBytes);
    pipe.InitBuffer(gQ, 2, chunkBytes);
    pipe.InitBuffer(outQ, 2, chunkBytes);
    pipe.InitBuffer(rstdBuf, 32);
    pipe.InitBuffer(workBuf, 256);                           // nChunk 个偏导（≤64）

    uint32_t start = AscendC::GetBlockIdx() * rowsPerCore;
    uint32_t end = start + rowsPerCore;
    if (end > R) end = R;
    uint32_t nChunk = CeilDivK(H, chunk);
    float avgFactor = 1.0f / (float)H;
    AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0};
    AscendC::LocalTensor<float> rstd = rstdBuf.Get<float>();
    AscendC::LocalTensor<float> work = workBuf.Get<float>();

    for (uint32_t r = start; r < end; ++r) {
        uint64_t rowOff = (uint64_t)r * H;
        // pass 1：每 chunk 的 Σx² 存 work[c]（x 读第 1 次）
        for (uint32_t c = 0; c < nChunk; ++c) {
            uint32_t colOff = c * chunk;
            uint32_t len = (colOff + chunk <= H) ? chunk : (H - colOff);
            AscendC::DataCopyExtParams cp;
            cp.blockCount = 1; cp.blockLen = len * (uint32_t)sizeof(float); cp.srcStride = 0; cp.dstStride = 0;
            AscendC::LocalTensor<float> xLocal = inQ.AllocTensor<float>();
            AscendC::DataCopyPad(xLocal, xGm[rowOff + colOff], cp, pad);
            inQ.EnQue(xLocal);
            xLocal = inQ.DeQue<float>();
            ChunkSumsqVF(xLocal, work, c, len);
            inQ.FreeTensor(xLocal);
        }
        WorkToRstdVF(work, rstd, nChunk, avgFactor, eps);    // 汇总 → rstd
        // pass 2：y = x·rstd·gamma（x 读第 2 次，gamma 分块载入）
        for (uint32_t c = 0; c < nChunk; ++c) {
            uint32_t colOff = c * chunk;
            uint32_t len = (colOff + chunk <= H) ? chunk : (H - colOff);
            AscendC::DataCopyExtParams cp;
            cp.blockCount = 1; cp.blockLen = len * (uint32_t)sizeof(float); cp.srcStride = 0; cp.dstStride = 0;
            AscendC::LocalTensor<float> xLocal = inQ.AllocTensor<float>();
            AscendC::DataCopyPad(xLocal, xGm[rowOff + colOff], cp, pad);
            inQ.EnQue(xLocal);
            AscendC::LocalTensor<float> gLocal = gQ.AllocTensor<float>();
            AscendC::DataCopyPad(gLocal, gammaGm[colOff], cp, pad);
            gQ.EnQue(gLocal);
            xLocal = inQ.DeQue<float>();
            gLocal = gQ.DeQue<float>();
            AscendC::LocalTensor<float> yLocal = outQ.AllocTensor<float>();
            NormVF(xLocal, gLocal, rstd, 0, yLocal, len);
            outQ.EnQue(yLocal);
            inQ.FreeTensor(xLocal);
            gQ.FreeTensor(gLocal);
            yLocal = outQ.DeQue<float>();
            AscendC::DataCopyPad(yGm[rowOff + colOff], yLocal, cp);
            outQ.FreeTensor(yLocal);
        }
    }
}

// ------------------------- 诊断 kernel：纯访存（读 x + 写 y，零计算） -------------------------
// 与 rms_norm_full 同样的 GM 流量(读537MB+写537MB)与 tile/双缓冲结构，但不做任何矢量计算。
// 用来判定 l 的 mte 瓶颈：若此拷贝≈rms_norm_full，则 743 是访存（读写未重叠/BW）现实，非计算拖累。
__global__ __aicore__ __vector__ void mem_copy(
    GM_ADDR x, GM_ADDR y, uint32_t R, uint32_t H, uint32_t rowsPerCore, uint32_t rowFactor)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> xGm, yGm;
    xGm.SetGlobalBuffer((__gm__ float*)x);
    yGm.SetGlobalBuffer((__gm__ float*)y);
    uint32_t rowBytes = RowBytes(H);
    uint32_t tileBytes = rowFactor * rowBytes;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQ;
    pipe.InitBuffer(inQ, 2, tileBytes);
    AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0};
    uint32_t start = AscendC::GetBlockIdx() * rowsPerCore;
    uint32_t end = start + rowsPerCore;
    if (end > R) end = R;
    for (uint32_t r = start; r < end; r += rowFactor) {
        uint32_t curRows = (r + rowFactor <= end) ? rowFactor : (end - r);
        AscendC::DataCopyExtParams cp;
        cp.blockCount = 1; cp.blockLen = curRows * H * (uint32_t)sizeof(float); cp.srcStride = 0; cp.dstStride = 0;
        AscendC::LocalTensor<float> xLocal = inQ.AllocTensor<float>();
        AscendC::DataCopyPad(xLocal, xGm[(uint64_t)r * H], cp, pad);   // 读
        inQ.EnQue(xLocal);
        xLocal = inQ.DeQue<float>();
        AscendC::DataCopyPad(yGm[(uint64_t)r * H], xLocal, cp);        // 写（同缓冲，零计算）
        inQ.FreeTensor(xLocal);
    }
}

// =============================== host ===============================
namespace {
inline uint32_t HCeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }

constexpr uint32_t UB_BYTES = 253952;   // Ascend950 UB/core = 248KB（MultiN rowFactor 预算用）

struct Args {
    uint32_t rows = 4096, cols = 4096, iters = 20, blocks = 0, chunk = 4096, rowfactor = 0;
    float eps = 1e-6f;
    std::string variant = "full";
};

Args ParseArgs(int argc, char** argv) {
    Args a;
    for (int i = 1; i < argc; ++i) {
        std::string k = argv[i];
        auto next = [&]() -> std::string { return (i + 1 < argc) ? argv[++i] : ""; };
        if (k == "--rows") a.rows = (uint32_t)atoi(next().c_str());
        else if (k == "--cols") a.cols = (uint32_t)atoi(next().c_str());
        else if (k == "--iters") a.iters = (uint32_t)atoi(next().c_str());
        else if (k == "--blocks") a.blocks = (uint32_t)atoi(next().c_str());
        else if (k == "--chunk") a.chunk = (uint32_t)atoi(next().c_str());
        else if (k == "--rowfactor") a.rowfactor = (uint32_t)atoi(next().c_str());
        else if (k == "--eps") a.eps = (float)atof(next().c_str());
        else if (k == "--variant") a.variant = next();
    }
    return a;
}

void GoldenRmsNorm(const std::vector<float>& x, const std::vector<float>& g,
                   std::vector<float>& y, uint32_t R, uint32_t H, float eps) {
    for (uint32_t r = 0; r < R; ++r) {
        double s = 0.0;
        const float* xr = x.data() + (size_t)r * H;
        for (uint32_t j = 0; j < H; ++j) s += (double)xr[j] * xr[j];
        float rstd = 1.0f / std::sqrt((float)(s / H) + eps);
        float* yr = y.data() + (size_t)r * H;
        for (uint32_t j = 0; j < H; ++j) yr[j] = xr[j] * rstd * g[j];
    }
}
}  // namespace

#define CK(call)                                                                                   \
    do {                                                                                           \
        aclError _e = (call);                                                                      \
        if (_e != ACL_SUCCESS) { printf("ACL FAIL %s:%d ret=%d\n", __FILE__, __LINE__, (int)_e); return 1; } \
    } while (0)

int main(int argc, char** argv) {
    Args a = ParseArgs(argc, argv);
    bool isSplit = (a.variant == "split");
    bool isCopy = (a.variant == "copy");
    uint32_t R = a.rows, H = a.cols;
    uint32_t blocks = a.blocks ? a.blocks : (R < 64 ? R : 64);
    uint32_t rowsPerCore = HCeilDiv(R, blocks);
    // MultiN rowFactor：按 UB 预算自适应（inQ+outQ 各双缓冲 + gamma），可 --rowfactor 覆盖。
    uint32_t rowBytesApprox = HCeilDiv(H * 4u, 1024u) * 1024u;
    uint32_t rfMax = (UB_BYTES > rowBytesApprox + 4096u)
                     ? (UB_BYTES - rowBytesApprox - 4096u) / (rowBytesApprox * 4u) : 1u;
    if (rfMax < 1u) rfMax = 1u;
    uint32_t rowFactor = a.rowfactor ? a.rowfactor : rfMax;
    if (rowFactor > rowsPerCore) rowFactor = rowsPerCore ? rowsPerCore : 1u;

    size_t nX = (size_t)R * H, nG = H;
    std::vector<float> hX(nX), hG(nG), hY(nX), gold(nX);
    std::mt19937 gen(12345);
    std::uniform_real_distribution<float> dist(-2.0f, 2.0f);
    for (auto& v : hX) v = dist(gen);
    for (auto& v : hG) v = dist(gen);
    GoldenRmsNorm(hX, hG, gold, R, H, a.eps);

    CK(aclInit(nullptr));
    CK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CK(aclrtCreateStream(&stream));

    void* dX = nullptr;
    void* dG = nullptr;
    void* dY = nullptr;
    CK(aclrtMalloc(&dX, nX * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc(&dG, nG * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc(&dY, nX * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMemcpy(dX, nX * sizeof(float), hX.data(), nX * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));
    CK(aclrtMemcpy(dG, nG * sizeof(float), hG.data(), nG * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));

    auto launch = [&]() {
        if (isCopy)
            mem_copy<<<blocks, nullptr, stream>>>((GM_ADDR)dX, (GM_ADDR)dY, R, H, rowsPerCore, rowFactor);
        else if (isSplit)
            rms_norm_split<<<blocks, nullptr, stream>>>((GM_ADDR)dX, (GM_ADDR)dG, (GM_ADDR)dY, R, H, a.eps, rowsPerCore, a.chunk);
        else
            rms_norm_full<<<blocks, nullptr, stream>>>((GM_ADDR)dX, (GM_ADDR)dG, (GM_ADDR)dY, R, H, a.eps, rowsPerCore, rowFactor);
    };

    launch();                                    // warmup
    CK(aclrtSynchronizeStream(stream));

    aclrtEvent evStart = nullptr, evStop = nullptr;
    CK(aclrtCreateEvent(&evStart));
    CK(aclrtCreateEvent(&evStop));
    CK(aclrtRecordEvent(evStart, stream));
    for (uint32_t i = 0; i < a.iters; ++i) launch();
    CK(aclrtRecordEvent(evStop, stream));
    CK(aclrtSynchronizeStream(stream));
    float ms = 0.0f;
    CK(aclrtEventElapsedTime(&ms, evStart, evStop));
    double usPerIter = (double)ms * 1000.0 / a.iters;

    CK(aclrtMemcpy(hY.data(), nX * sizeof(float), dY, nX * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST));

    const std::vector<float>& ref = isCopy ? hX : gold;   // copy 变体期望输出 = x 本身
    double maxRel = 0.0;
    for (size_t i = 0; i < nX; ++i) {
        float d = std::fabs(hY[i] - ref[i]);
        float den = std::fabs(ref[i]) + 1e-6f;
        double rel = d / den;
        if (rel > maxRel) maxRel = rel;
    }
    bool ok = maxRel < 2e-3;

    printf("RESULT op=rms_norm variant=%s rows=%u cols=%u blocks=%u chunk=%u rowfactor=%u iters=%u "
           "us=%.3f golden=%s maxRel=%.2e\n",
           a.variant.c_str(), R, H, blocks, isSplit ? a.chunk : 0u, isSplit ? 0u : rowFactor, a.iters, usPerIter,
           ok ? "PASS" : "FAIL", maxRel);

    aclrtDestroyEvent(evStart);
    aclrtDestroyEvent(evStop);
    aclrtFree(dX); aclrtFree(dG); aclrtFree(dY);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return ok ? 0 : 2;
}
